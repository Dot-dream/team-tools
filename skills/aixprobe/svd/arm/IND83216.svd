          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>VTEMP_SEL</name>
              <description>Over Temp protect threshold temp trim. Select the OVTEMP threshold level for the monitor.0x0: Rising: 123.4; Falling: 107.4 ; HYS: 160x1: Rising: 127.4; Falling: 110.4 ; HYS: 170x2: Rising: 131.4; Falling: 114.4 ; HYS: 170x3: Rising: 135.4; Falling: 117.4 ; HYS: 180x4: Rising: 138.4; Falling: 121.4 ; HYS: 170x5: Rising: 142.4; Falling: 125.4 ; HYS: 170x6: Rising: 146.4; Falling: 128.4 ; HYS: 180x7: Rising: 151.4; Falling: 132.4 ; HYS: 190x8: Rising: 155.4; Falling: 136.4 ; HYS: 190x9: Rising: 165.0; Falling: 132.0 ; HYS: 330xa: Rising: 163.4; Falling: 144.4 ; HYS: 190xb: Rising: 167.4; Falling: 148.4 ; HYS: 190xc: Rising: 171.4; Falling: 153.4 ; HYS: 180xd: Rising: 175.4; Falling: 157.4 ; HYS: 180xe: Rising: 180.4; Falling: 161.4 ; HYS: 190xf: Rising: 184.4; Falling: 166.4 ; HYS: 18</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TEMPSENSE_EN</name>
              <description>enable Temp Sensor Analog Part. Set to enable Temperature Sensor analog circuit.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TRIM_OTP_1U</name>
              <description>Trim 1uA for OTP @27C0x0: 0uA     0x1: 0.125uA 0x2: 0.25 uA 0x3: 0.375uA 0x4: 0.5uA   0x5: 0.625uA 0x6: 0.75uA  0x7: 0.875uA 0x8: 1uA    (default)0x9: 1.125uA 0xa: 1.25uA  0xb: 1.375uA 0xc: 1.5uA   0xd: 1.625uA 0xe: 1.75uA  0xf: 1.875uA</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PMU_CTRL</name>
          <description>PMU Control. NOTE:The write operation of this field register takes effect by configuring 'TRIM_HV-&gt;CFG.CFG_ACCESS_KEY = 0xB'</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
