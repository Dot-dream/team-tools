              <name>TRIM_VREF_BUF</name>
              <description>Trim the buffer refernce voltage include VREF_1/VREF_1P1/VREF_0P75/VREF_0P6.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
