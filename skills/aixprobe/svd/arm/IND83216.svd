              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET_DWELL</name>
              <description>Reset dwell time. Defines the amount of time spent in the 'RESET' state.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENA_1V5_DWELL</name>
              <description>ENA_1V5 dwell time. Defines the amount of time spent in the 'ENA_1V5' state.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PMU_TRIM</name>
          <description>PMU Trim Register. NOTE:The write operation of this field register takes effect by configuring 'TRIM_HV-&gt;CFG.CFG_ACCESS_KEY = 0xB'</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>VDD1V5_LDO_TRIM</name>
              <description>1.5V LDO Capless output trim. at PMU debug mode0x0: 1.454 V0x1: 1.481 V0x2: 1.511 V0x3: 1.546 V(default)0x4: 1.574 V0x5: 1.606 V0x6: 1.642 V0x7: 1.682 V</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VDD3V3_LDO_TRIM</name>
              <description>3.3V LDO output trim. at PMU debug mode0x0: 3.079V0x1: 3.138V0x2: 3.199V0x3: 3.264V0x4: 3.333V(default)0x5: 3.405V0x6: 3.482V0x7: 3.563V</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
