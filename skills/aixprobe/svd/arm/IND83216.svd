        <register>
          <name>SARINT</name>
          <description>SAR Interrupts</description>
          <addressOffset>0x0000003C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INT_CONV_DONE_ENA</name>
              <description>Convert Done Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_TRIG_CLASH_ENA</name>
              <description>Trigger Clash Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_CONV_DONE_CLR</name>
              <description>Convert Done Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>INT_TRIG_CLASH_CLR</name>
              <description>Trigger Clash Interrupt Clear.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CONV_DONE</name>
              <description>Convert Done. Set by the SAR when an conversion is done.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TRIG_CLASH</name>
              <description>Trigger Clash. Set by the SAR when new trigger issued when previous has not finished.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>INT_CONV_DONE</name>
              <description>Convert Done Interrupt. Set by the SAR when an convert done occurs</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>INT_TRIG_CLASH</name>
              <description>Trigger Clash Interrupt. Set by the SAR when TRIG_CLASH is high and INT_TRIG_CLASH_ENA is set</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SARCLKDIV</name>
          <description>SAR CLOCK DIVIDE</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SARCLKDIV</name>
              <description>SAR CLOCK DIVIDE. Divide ration is (SAR_CLK_DIV+1)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UART0</name>
      <version>B0</version>
      <description>UART Interface registers</description>
      <groupName>UART0</groupName>
      <prependToName>UART0_</prependToName>
      <baseAddress>0x50015400</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DATA</name>
          <description>Data</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BYTE</name>
              <description>Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DUMMY0</name>
              <description>Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DUMMY1</name>
              <description>Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DUMMY2</name>
              <description>Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTDATARECEIVESTATUS</name>
          <description>Data Receive Status</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FRAMEERROR</name>
              <description>Framing Error. When this bit is set to 1, it indicates that the received byte did not have a valid stop bit (a valid stop bit is 1).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PARITYERROR</name>
              <description>Parity Error. When this bit is set to 1, it indicates that the parity of the received data character has parity error.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BREAKERROR</name>
              <description>Break Error. This bit is set to 1 if a break condition was detected, indicating that the received data input was held LOW for longer than a full-word transmission time (defined as start, data, parity, and stop bits).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSGCTRL</name>
          <description>Message control</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable. Set to enable the UART</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENABLE_STS</name>
              <description>Enable status. Status of UART enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>UFIFOSOFTRESET</name>
              <description>FIFO SOFT RESET. Resets FIFO pointers to zero and initializes FIFO contents to zeroAutoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RXXFERCNTCLR</name>
              <description>RX Transfer Counter Clear. Clear RX Multi Transfer Counter to zeroAutoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TXXFERCNTCLR</name>
              <description>TX Transfer Counter Clear. Clear TX Multi Transfer Counter to zeroAutoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SIZE</name>
              <description>Transmission word size. 0x0: 5-bit0x1: 6-bit0x2: 7-bit0x3: 8-bit</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STOP</name>
              <description>Stop bit control. 0x0: One stop bit0x1: If a 5-bit transmission it selects 1.5 stop bits, otherwise 2 stop bits (6, 7 &amp; 8 bits)</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PARENA</name>
              <description>Parity enable. Set to enable parity (see PARODD for odd/even)</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PARODD</name>
              <description>Odd parity. 0x0: ODD Parity0x1: EVEN parity</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STICKENA</name>
              <description>Sticky parity enable. Set to enable sticky parity</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BREAKENA</name>
              <description>Break enable. Set to force transmission of zero (for a break condition)</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LOOPENA</name>
              <description>Loopback enable. Set to enable loopback</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTINT</name>
          <description>UART Interrupts</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RXDONE_ENA</name>
              <description>Rx Data ready Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OVRUNERR_ENA</name>
              <description>RX FIFO overflow error Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FRMERR_ENA</name>
              <description>Framing error Interrupt Enable.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRTYERR_ENA</name>
              <description>Parity Error Interrupt Enable.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BREAKKERR_ENA</name>
              <description>Break Error Interrupt Enable.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXDONE_ENA</name>
              <description>Transmission done Interrupt Enable.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXMULTDONE_ENA</name>
              <description>Multiple Receive Transactions Done Interrupt Enable.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXMULTDONE_ENA</name>
              <description>Multiple Transmit Transactions Done Interrupt Enable.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXDONE_CLR</name>
              <description>Rx Data ready Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>OVRUNERR_CLR</name>
              <description>RX FIFO overflow error Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>FRMERR_CLR</name>
              <description>Framing error Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>PRTYERR_CLR</name>
              <description>Parity Error Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>BREAKKERR_CLR</name>
              <description>Break Error Interrupt  Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TXDONE_CLR</name>
              <description>Transmission done Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RXMULTDONE_CLR</name>
              <description>Multiple Receive Transactions Done Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TXMULTDONE_CLR</name>
              <description>Multiple Transmit Transactions Done Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RXDONE_STS</name>
              <description>Rx Data ready. Set by the UART when Rx data is ready</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVRUNERR_STS</name>
              <description>RX FIFO overflow error. Set by the UART when an overrun error occurs</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FRMERR_STS</name>
              <description>Framing error. Set by the UART when a framing error occurs</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PRTYERR_STS</name>
              <description>Parity Error. Set by the UART when a parity error occurs</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BREAKKERR_STS</name>
              <description>Break IRQ. Set by the UART when a break error occurs</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXDONE_STS</name>
              <description>Transmission is done. Set by the UART when the transmit is done</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXMULTDONE_STS</name>
              <description>Multiple Receive Transactions Done. Set by the UART when the programmed number of receive transactions have completed. See UART_FIFO_LEVEL_CTL register</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXMULTDONE_STS</name>
              <description>Multiple Transmit Transactions Done. Set by the UART when the programmed number of transmit transactions have completed. See UART_FIFO_LEVEL_CTL register.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXDONE_IRQ</name>
              <description>Rx Data ready Interrupt. Set by the UART when Rx data is ready</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVRUNERR_IRQ</name>
              <description>RX FIFO overflow error Interrupt. Set by the UART when an overrun error occurs</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FRMERR_IRQ</name>
              <description>Framing error Interrupt. Set by the UART when a framing error occurs</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PRTYERR_IRQ</name>
              <description>Parity Error Interrupt. Set by the UART when a parity error occurs</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BREAKKERR_IRQ</name>
              <description>Break Error Interrupt. Set by the UART when a break error occurs</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXDONE_IRQ</name>
              <description>Transmission done Interrupt. Set by the UART when the transmission is done</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXMULTDONE_IRQ</name>
              <description>Multiple Receive Transactions Done Interrupt. Set by the UART when the programmed number of receive transactions have completed. See UART_FIFO_LEVEL_CTL register</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXMULTDONE_IRQ</name>
              <description>Multiple Transmit Transactions Done Interrupt. Set by the UART when the programmed number of transmit transactions have completed. See UART_FIFO_LEVEL_CTL register.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTINT2</name>
          <description>Extended UART Interrupts</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RXTOUT_ENA</name>
              <description>Rx Time-out Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UNRUNERR_ENA</name>
              <description>RX FIFO underflow error Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OVERRUNERR_ENA</name>
              <description>TX FIFO overflow error Interrupt Enable.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXTOUT_CLR</name>
              <description>Rx Time-out Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>UNRUNERR_CLR</name>
              <description>RX FIFO underflow error Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>OVERRUNERR_CLR</name>
              <description>TX FIFO overflow error Interrupt Clear. Autoclear:  includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RXTOUT_STS</name>
              <description>Rx Time-out. Set by the UART when timeout of 4 data frame times without reception, and data received(one or three bytes received,programmable)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>UNRUNERR_STS</name>
              <description>RX FIFO underflow error. Set by the UART when an under flow error occurs.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVERRUNERR_STS</name>
              <description>TX FIFO overflow error. Set by the UART when an TX FIFO overflow error occurs.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXTOUT_IRQ</name>
              <description>Rx Time-out Interrupt. Set by the UART when RXTOUT flag is set and RXOUT interrupt is enabled.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>UNRUNERR_IRQ</name>
              <description>RX FIFO underflow error Interrupt. Set by the UART when an under flow error interrupt occurs.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVERRUNERR_IRQ</name>
              <description>TX FIFO overflow error Interrupt. Set by the UART when an TX FIFO overflow error interrupt occurs.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTBAUD</name>
          <description>UART Baud rate</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FDIV</name>
              <description>Fractional divider.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BAUDDIV</name>
              <description>Baud rate divider.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OSR</name>
              <description>Over-sampling ratio. Valid OSR Range: 6 to 16.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UADVANCE</name>
              <description>Advance Register. Advances the sample window by 1 cycle. For Debug.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>URETARD</name>
              <description>Retard Register. Retards the sample window by 1 cycle. For Debug.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTFIFO</name>
          <description>UART FIFO interface</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RXEMPTY</name>
              <description>Reception FIFO empty.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXFULL</name>
              <description>Reception FIFO full.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXCOUNT</name>
              <description>Reception FIFO current count.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXEMPTY</name>
              <description>Transmit FIFO empty.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXFULL</name>
              <description>Transmit FIFO full.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXCOUNT</name>
              <description>Transmit FIFO current count.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXMULTIPLEXFERDONECNT</name>
              <description>Receive Data Count Interrupt. Minimum number of bytes in the receive FIFO before a INT_RX_MULTIPLE_XFER_DONE interrupt is asserted.  Example: A value of 4 would be used to compare to the number of receive transactions (pushes to the Rx FIFO).  Valid Range: 1 to 16</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXMULTIPLEXFERDONECNT</name>
              <description>Transmit Data Count Interrupt. Number of bytes transmitted from the transmit FIFO before a INT_TX_MULTIPLE_XFER_DONE interrupt is asserted.  Example: A value of 4 would be used to compare to the number of completed transfers (pops from the Tx FIFO).  Valid Range: 1 to 16</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SYSCFG</name>
      <version>B0</version>
      <description>System Configuration Located in Power Down Domain.</description>
      <groupName>SYSCFG</groupName>
      <prependToName>SYSCFG_</prependToName>
      <baseAddress>0x50020000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SRAMCFGR</name>
          <description>SRAM Configuration Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAMECCADDR</name>
              <description>SRAM ECC Error Address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SRAMECCC</name>
              <description>SRAM ECC correction. Set by hardware when one bit ECC error has been detected and corrected when access sram. An interrupt is generated if SRAMECCIE is set. Cleared by writing 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SRAMECCD</name>
              <description>SRAM ECC detection. Set by hardware when two bits ECC errors has been detected and corrected when access SRAM. When this bit is set, a NMI is generated. Cleared by writing 1.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLSECCDNMI</name>
              <description>Flash ECC detection Indication. This bit reflect status of ECCD bit of register FLSECCR.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SRAMECCCIE</name>
              <description>SRAM ECC correction interrupt enable. 0x0: SRAMECCC interrupt disabled0x1: SRAMECCC interrupt enabled</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SRAMECCDIS</name>
              <description>SRAM ECC Disable bit. 0x0: SRAM ECC function enabled0x1: SRAM ECC function disabled</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMRACR</name>
          <description>SRAM Raw Access Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAM_RAWACC_EN</name>
              <description>SRAM Raw Access Enable. Set to enable raw access to SRAM.  NOTE: SRAM_ECC_DIS need to set when executing raw access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WR_ECC_RAW</name>
              <description>ECC Raw Value for Write. This field will write to SRAM when bit[31:24] is writing and SRAM_RAWACC_EN is set.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RD_ECC_RAW</name>
              <description>ECC Raw Value for Read. This field store the data from SRAM bit[38:32] when SRAM_RAWACC_EN is set.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMWPKEYR</name>
          <description>SRAM Write Protection Register key register</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAMWPKEY</name>
              <description>Write pretection key for SRAMWPR to take effect. A value of 0x26 must be written to this address to allow SRAMWPR to take effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMWPR</name>
          <description>SRAM Write Protection Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAMWP</name>
              <description>SRAM Write Protection. Each bit protect 1Kbyte SRAM area, bit0 correspondint the first 1Kbyte. This field is set only.0x0: Corresponding 1K area can be modified0x1: Corresponding 1K area write protected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>M0IVTRKEYR</name>
          <description>M0 Interrupt Vector Table write key register</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>M0IVTRKEY</name>
              <description>Write pretection key for M0IVTR to take effect. A value of 0x53 must be written to this address to allow M0IVTR to take effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>M0IVTR</name>
          <description>M0 Interrupt Vector Table Register</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>IVTBADDR</name>
              <description>Interrupt Vector Table Base Address. This field contains the base address of the interrupt vector table remapping block. IVT_BADDR will be used to replace Address[15:8] if Address[31:8] is equal to 0x0 (Access first 256 byte space). When IVTRAMSEL=0, remapped address will be {Address[31:16],IVTBADDR,Address[7:0]}; When IVTRAMSEL=1, remapped address will be {16'h2000,IVTBADDR,Address[7:0]}.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IVTRAMSEL</name>
              <description>IVT SRAM Selection. 0x0: IVT is located in Flash0x1: IVT is located in SRAM</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>FLASH</name>
      <version>B0</version>
      <description>Control (and status) registers for FMC</description>
      <groupName>FLASH</groupName>
      <prependToName>FLASH_</prependToName>
      <baseAddress>0x50021000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FLADDR</name>
          <description>Destination address for flash write or erase operation</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLASHADDR</name>
              <description>Target flash line for write/erase operation. In byte writes, this is the line address of the flash to be written to. In erase modes, it is an address inside the sector to be erased. NOTE:This register must be written in the correct sequence or the operation will fail.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NVR</name>
              <description>NVR indication for write/erase operation.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATALR</name>
          <description>Data (least-significant word)</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATAL</name>
              <description>Data (least-significant word). The least-significant, 32-bit word of data that will be written to Flash</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATAMR</name>
          <description>Data (most-significant word)</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATAM</name>
              <description>Data (most-significant word). The most-significant, 32-bit word of data that will be written to Flash</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ECCVALR</name>
          <description>ECC value and status</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ECCVAL</name>
              <description>ECC value. If ECCSTREN = 1, 8bit redundant bits will be stored into ECCVAL during each flash fetch operation. NOTE:If RDECCEN = 1, this field may be corrected by ECC algorithm. During programming ECCVAL will be copied to the 8bit redundant bits of a Flash word. This field will update by syndrome code generated by ECC encoder when DATAM is written with 32-bit data. This field can still be updated by software after hardware update, through this method we can implement raw data program into flash 72bit line.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UNLBWR</name>
          <description>Flash write unlock register</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>UNLOCK_WRITE</name>
              <description>Control register to unlock write. A value of 0x55555555 must be written to this address at the correct point in the write sequence or the operation will fail. Bit 0 will be set if 0x55555555 is written, and will be clear if write operation is started successfully or any other value is written the this register. Other bits read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BWRSTRTR</name>
          <description>Flash write start register</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WRITE_START</name>
              <description>Control register to start a write. A value of 0xAAAAAAAA or 0x502901FF (program to NVR1) must be written to this address at the correct point in the write sequence or the operation will fail. Read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UNLERSR</name>
          <description>Flash erase unlock register</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>UNLOCK_ERASE</name>
              <description>Control register to unlock a erase operation.  A value of 0x66666666 must be written to this address at the correct point in the erase sequence or the operation will fail. Bit 0 will be set if 0x66666666 is written, and will be clear if erase operation is started successfully or any other value is written the this register. Other bits read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ERSSTRTR</name>
          <description>Flash erase start register</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ERASE_START</name>
              <description>Control register to commit a sector erase.  A value of 0x99999999 or 0x502901FF (Sector erase to NVR1)  must be written to this address at the correct point in the sector erase sequence or the operation will fail. Read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSCPR</name>
          <description>Flash code protection register</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CODE_PROT</name>
              <description>Code Protection / SerialWire Lockout Control  Write a value of 0xF2E11047 to disable the SerialWire interface. Write other values will enable it.   This allows the user program to disable the SerialWire interface to prevent unauthorized debug access to the part.  Bit 0 will be set if 0xF2E11047 is written, and will be clear if any other value is written the this register. Other bits read return zero. NOTE1: This register does not lock the Flash Memory against read/write/erase by the applications program. Instead what it does is to disable all communications with the debug interface, therefore preventing any external attack. The application code is still able to modify the flash content.  NOTE2:  Upon Power-On Reset or Normal Reset the system disables the communication for a small time interval (8192 clock cycles). If the application needs to be protected it is mandatory to set this register with the appropriate code in the beginning of the initialization process and before the internal hardware enable the debug communication. NOTE3:  Program 0xF2E11047 in last Flash address(low 32 bits of 8Bytes) of Main Memory can also realize Code Protection.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWPKEYR</name>
          <description>Flash write protection key register</description>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WPKEY</name>
              <description>Flash write pretection key for FLSWPx to take effect. A value of 0x12100511 must be written to this address to allow FLSWP0 and FLSWP1 to take effect. Once FLSWPx have taken effect it will be locked for safety. Bit 0 will be set if 0x12100511 is written, and can only be cleared by system reset. Other bits read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWP0R</name>
          <description>Flash write protection 0 register</description>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLSWP0</name>
              <description>Flash write protection field protect one kilo byte by one bit. Bit0 protect the first KB, bit1 for the second KB, ... NOTE: This field only take effect after correct key has been written to FLSWPKEYR. And this field can not be modified after taking effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWP1R</name>
          <description>Flash write protection 1 register</description>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLSWP1</name>
              <description>Flash write protection field protect one kilo byte by one bit. Bit0 protects the 33th KB, bit1 for the 34th KB, ... NOTE: This field only take effect after correct key has been written to FLSWPKEYR. And this field can not be modified after taking effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWP2R</name>
          <description>Flash write protection 2 register</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLSWPNVR</name>
              <description>Flash write protection field for NVR sectors. FLSWPNVR protects the first and the second NVR sector NOTE: This field only take effect after correct key has been written to FLSWPKEYR. And this field can not be modified after taking effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLS_UNLOCK_CTRL_OPR</name>
          <description>Flash Unlock Control Operation Register</description>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>UNLOCK_CTRL_OP</name>
              <description>Flash Control Operation Register Unlock value. 0xACDC_1972 needs to be written in this register to unlock the Control Operation Register access. When this register is read, it returns the state of the lock:  0: The Control Operation Register is locked. The CHIPSEL bit of FLASH_CTRL_OPR cannot be written.  1: The Control Operation Register is unlocked. The CHIPSEL bit of FLASH_CTRL_OPR can be written.  NOTE: After each write to the third byte of FLASH_CTRL_OPR register, the state of the lock is cleared and the pattern needs to be written again to allow a new configuration of the register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL_OPR</name>
          <description>Flash Control Operation Register</description>
          <addressOffset>0x00000038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BYTESEL</name>
              <description>Byte selection of the write operation. Set to 1 indicated the corresponding 2Bytes will be programmed. NOTE1: This register is only used in debug mode, and locked by debug_key. In function mode, 8Bytes need to be programmed together. NOTE2: BYTESEL's set bits must be continuous, otherwise will cause unintentional chaos. ex. 4'b1100, 4'b0110, 4'b0011, 4'b1000 are valid setting, 4'b1011, 4'b1001 are not allowed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHIPSEL</name>
              <description>CHIP selection bit. This bit is only used during the Erase operation. It allows the system to execute mass erase.  0: The Erase operation will only erase the sector selected by the FLASH_ADDR register value.  1: The Erase operation will erase the full main array of the flash. NOTE:CHIPSEL can only be written when bit-0 of FLS_UNLOCK_CTRL_OPR is set.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ECCSTREN</name>
              <description>ECC Store Enable. When set, 8bit redundant bits will be stored into ECCVAL during every flash fetch operation.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PROGVREAD</name>
              <description>Program Margin Read Enable. Set to enable margin read for program cell verification. NOTE:After set PROGVREAD, must wait one cycle to issued new flash read to execute program margin read.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERSVREAD</name>
              <description>Erase Margin Read Enable. Set to enable margin read for erase cell verification. NOTE:After set ERSVREAD, must wait one cycle to issued new flash read to execute erase margin read.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CFVREAD</name>
              <description>READ configuration registers. To read registers’ configuration data to DOUT for check</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CONFEN</name>
              <description>Set configuration registers. To write configuration data to registers</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>READONLY</name>
              <description>Read only enable. Only can do read operation to Flash, disable program and erase function .the program or erase operation will be aborted immediately if enable READONLY.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FRWS</name>
              <description>Flash Read Wait State Number. Number of wait states used in the reading process. Each read from flash memory will take number of cycles equal to 1+FRWS to complete. NOTE:FRWS = 2 is adequate for normal read. When in margin read, make sure (1 + FRWS ) * Fhclk is slower than 225ns.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RCELL</name>
              <description>Reference cell selected operation. RCELL =1 only for reference cell initialization for Flash IP without CP testing. RCELL =0 for other cases.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TERS</name>
              <description>Transfer cell erase operation. TERS=1 only for transfer cell initialization for Flash IP without CP testing. TERS=0 for other cases.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSECCR</name>
          <description>Flash ECC Register</description>
          <addressOffset>0x0000003C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDRECC</name>
              <description>ECC fail double-word address offset. In case of ECC error or ECC correction detected, this bitfield contains double-word offset (multiple of 64 bits) to Main Flash memory or to NVR1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NVRFECC</name>
              <description>NVR ECC fail. This bit indicates that the ECC error correction or double ECC error detection is located in the NVR Flash memory.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RDECCEN</name>
              <description>Read ECC correction and detection Enable. ECC correction and detection will only be enabled when RDECCEN is set.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ECCCIE</name>
              <description>ECC correction interrupt enable. 0x0: ECCC interrupt disabled0x1: ECCC interrupt enabled</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WPVIOLIE</name>
              <description>Write Protection Violation interrupt enable. 0x0: WPVIOL interrupt disabled0x1: WPVIOL interrupt enabled</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WPVIOL</name>
              <description>Write Protection Violation. Set by hardware when flash write protection has been violated. An interrupt is generated if WPVIOLIE is set. Cleared by writing 1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ECCC</name>
              <description>ECC correction. Set by hardware when one ECC error has been detected and corrected. An interrupt is generated if ECCIE is set. Cleared by writing 1.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ECCD</name>
              <description>ECC detection. Set by hardware when two ECC errors has been detected. When this bit is set, a NMI is generated. Cleared by writing 1.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TRIM</name>
          <description>Flash Trim Register</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>OSC_TRIM</name>
              <description>Oscillator Trim Value. This register will be automatically populated with the value stored in the least significant bits of NVR sector 1 (@0002_0000).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSSTATR</name>
          <description>Flash Status Register</description>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>OPBSY</name>
              <description>Flash operatoin busy indication. Reading 1 indicate program/erase operation busy. NOTE: In the SWD erase operation, OPBSY may be started 256 cycles later after command issued.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATAFIELDCTRL</name>
          <description>Flash data field with optional ecc register</description>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATAECCDIS</name>
              <description>0x0: ECC for data field enabled0x1: ECC for data field disabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DATAFIELDADDR</name>
              <description>Flash data field base address. Flash data field base address.  DATAFIELDADDR = 0 represent DATA field start at the 1st sector of main array, DATAFIELDADDR = 127 represent DATA field start at the last sector of main array,and ends at the end address of the 128th sector</description>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLASHARRDNINFO</name>
          <description>FLASH Redundancy Sector Information Registers</description>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ARRDN0ADDR</name>
              <description>FLASH ARRND0 Sector Address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ARRDN0ENA</name>
              <description>FLASH ARRDN0 Sector Enable.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ARRDN1ADDR</name>
              <description>FLASH ARRND1 Sector Address.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ARRDN1ENA</name>
              <description>FLASH ARRDN1 Sector Enable.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL0R</name>
          <description>Flash Operation Time Length 0 Register</description>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SERTL</name>
              <description>Sector Erase Time Length. This register define the duration of sector erase operation in number of 4M oscillator's cycles. Default duration is 4.5ms</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PGTL</name>
              <description>Program Time Length. This register define the duration of byte program operation in number of 4M oscillator's cycles. Default duration is 5750ns</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL1R</name>
          <description>Flash Operation Time Length 1 Register</description>
          <addressOffset>0x00000054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MERTL</name>
              <description>Chip Mass Erase Time Length. This register define the duration of chip mass erase operation in number of 4M oscillator's cycles. Default duration is 35ms</description>
              <bitOffset>0</bitOffset>
              <bitWidth>18</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL2R</name>
          <description>Flash Operation Time Length 2 Register</description>
          <addressOffset>0x00000058</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>NVS_ERASE_TL</name>
              <description>Sector Erase ERASE/CE/NVR to WE Setup time. This register define the setup time from ERASE/CE/NVR to WE operation in number of 4M oscillator's cycles. Default duration is 25us</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADH_TL</name>
              <description>Program BYTE/Address/data Hold time. This register define the hold time of BYTE/Address/data operation in number of 4M oscillator's cycles. Default duration is 0.75us</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PGH_TL</name>
              <description>Program Fall of PROG2 to fall of WE Hold time. This register define the Hold time of PROG2's fall to WE's fall operation in number of 4M oscillator's cycles. Default duration is 0.75us</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL3R</name>
          <description>Flash Operation Time Length 3 Register</description>
          <addressOffset>0x0000005C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RCV_ERASE_SEC_TL</name>
              <description>Sector Erase Recovery time. This register define the setup time from WE fall to ERASE fall operation in number of 4M oscillator's cycles. Default duration is 60us</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RCV_ERASE_CHIP_TL</name>
              <description>Sector Erase Recovery time. This register define the setup time from WE fall to ERASE fall operation in number of 4M oscillator's cycles. Default duration is 230us</description>
              <bitOffset>16</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL4R</name>
          <description>Flash Operation Time Length 4 Register, load from NVR at first</description>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PGS_TL</name>
              <description>Program Rise of WE to rise of PROG2 Setup time. This register define the setup time from rise of WE to rise of PROG2 operation in number of 4M oscillator's cycles. Default duration is 60us</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NVS_PROG_TL</name>
              <description>Program PROG/CE/NVR/BYTE/Address to WE Setup time. This register define the setup time from PROG/CE/NVR/BYTE[0:3]/Address to WE operation in number of 4M oscillator's cycles. Default duration is 25us</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL5R</name>
          <description>Flash Operation Time Length 5 Register, load from NVR at first</description>
          <addressOffset>0x00000064</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RCV_PROG_TL</name>
              <description>Program Recovery time. This register define the setup time from WE fall to PROG fall operation in number of 4M oscillator's cycles. Default duration is 60us</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER0</name>
      <version>B0</version>
      <description>General purpose timer 0 registers</description>
      <groupName>TIMER0</groupName>
      <prependToName>TIMER0_</prependToName>
      <baseAddress>0x50022000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>COUNT</name>
          <description>Timer Counter Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT</name>
              <description>Count. Initial counter value. The timer will count from this value to 0xFFFFFFFF and roll over to 0x00000000. At this point it will generate an interrupt if enabled. The interrupt routine is responsible for reloading the value if needed as this timer does not auto-reload the original content.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <description>Timer Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>Enable. This bit starts/stops the timer: &lt; br&gt; 1 = Timer Running &lt; br&gt; 0 = Timer Inactive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER1</name>
      <version>B0</version>
      <description>General purpose timer 1 registers</description>
      <groupName>TIMER1</groupName>
      <prependToName>TIMER1_</prependToName>
      <baseAddress>0x50022008</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>COUNT</name>
          <description>Timer Counter Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT</name>
              <description>Count. Initial counter value. The timer will count from this value to 0xFFFFFFFF and roll over to 0x00000000. At this point it will generate an interrupt if enabled. The interrupt routine is responsible for reloading the value if needed as this timer does not auto-reload the original content.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <description>Timer Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>Enable. This bit starts/stops the timer: &lt; br&gt; 1 = Timer Running &lt; br&gt; 0 = Timer Inactive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER2</name>
      <version>B0</version>
      <description>General purpose timer 2 registers</description>
      <groupName>TIMER2</groupName>
      <prependToName>TIMER2_</prependToName>
      <baseAddress>0x50022010</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>COUNT</name>
          <description>Timer Counter Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT</name>
              <description>Count. Initial counter value. The timer will count from this value to 0xFFFFFFFF and roll over to 0x00000000. At this point it will generate an interrupt if enabled. The interrupt routine is responsible for reloading the value if needed as this timer does not auto-reload the original content.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <description>Timer Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>Enable. This bit starts/stops the timer: &lt; br&gt; 1 = Timer Running &lt; br&gt; 0 = Timer Inactive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WDT1</name>
      <version>B0</version>
      <description>The watchdog timer that is local to VERNE MCU</description>
      <groupName>WDT1</groupName>
      <prependToName>WDT1_</prependToName>
      <baseAddress>0x50022018</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CFG</name>
          <description>Config</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>WDT Enable. This bit can be asserted but it cannot be de-asserted. It means that once the WDT is enabled it cannot be turned off until a Reset or Power-On Reset occurs.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSTEN</name>
              <description>Reset enable. If enabled a WDT time-out will force the microcontroller to reset. This bit can be asserted but it cannot be de-asserted.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSTFLAG</name>
              <description>Reset flag. This flag is set by the system at the initialization if the initialization was caused by a reset triggered by the WDT. The bit can be cleared by the application.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRESET</name>
              <description>Preset. Defines the watchdog timeout period.  It means that the WDT internal counter will count from 0 to the prescaler value at the system clock speed and trigger if not cleared. For instance, a system running from a 30MHz Crystal with WDTPRES[1I0] = 10 will trigger the WDT after approximately 0.14 seconds if not cleared properly and in time by the application.0x0: 2^13 / System Clock0x1: 2^19 / System Clock0x2: 2^22 / System Clock0x3: 2^32 / System Clock</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>KEY</name>
          <description>Key</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>Key. To clear the WDT counting the following words must be written in this order and without any other instruction between then:  0x3C570001  0x007F4AD6</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CRC</name>
      <version>B0</version>
      <description>CRC32 Registers.</description>
      <groupName>CRC</groupName>
      <prependToName>CRC_</prependToName>
      <baseAddress>0x50022100</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0010</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CRCDR</name>
          <description>CRC Data Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CRCDATA0</name>
              <description>CRC data bits. This register is used to write new data to the CRC calculator. When read it returns the previous CRC calculation result or the data write to CRCINIT If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCDATA1</name>
              <description>CRC data bits. This register is used to write new data to the CRC calculator. When read it returns the previous CRC calculation result or the data write to CRCINIT If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCDATA2</name>
              <description>CRC data bits. This register is used to write new data to the CRC calculator. When read it returns the previous CRC calculation result or the data write to CRCINIT If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCDATA3</name>
              <description>CRC data bits. This register is used to write new data to the CRC calculator. When read it returns the previous CRC calculation result or the data write to CRCINIT If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CRCIR</name>
          <description>CRC Initial Value Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CRCINIT</name>
              <description>CRC initial value. This register is used to write the CRC initial value. The data write to this register will be stored in CRCDATA until it replaced by new calculated result NOTE: This register can only be writen by word</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CRCCR</name>
          <description>CRC Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>REVIN</name>
              <description>Reverse input data. These bits control the reversal of the bit order of the input data0x0: Bit order not affected0x1: Bit reversal done by byte0x2: Bit reversal done by half-word0x3: Bit reversal done by word</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REVOUT</name>
              <description>Reverse output data. This bit controls the reversal of the bit order of the output data.0x0: Bit order not affected0x1: Bit order is reversed</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>