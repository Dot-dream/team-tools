            <field>
              <name>ADCVREFSELCH1</name>
              <description>	Channel1 adc vref select.
0x0: adc_vref = vbg
0x1: adc_vref = 2*vbg
0x2: adc_vref = VDD_3V3
0x3: adc_vref = VDD_3V3</description>
