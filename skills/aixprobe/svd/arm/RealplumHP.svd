0x0: Divide by 1
0x1: Divide by 2
0x2: Divide by 4
0x3: Divide by 8
0x4: Divide by 16
0x5: Divide by 64
0x6: Divide by 256
0x7: Divide by 1024</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PERIOD0</name>
