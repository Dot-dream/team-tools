              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BREAKKERR_INTERRUPT</name>
              <description>	Break Error Interrupt. Set by the UART when a break error occurs</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXDONE_INTERRUPT</name>
              <description>	Transmission done Interrupt. Set by the UART when the transmission is done</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXMULTDONE_INTERRUPT</name>
              <description>	Multiple Receive Transactions Done Interrupt. Set by the UART when the programmed number of receive transactions have completed. See UART_FIFO_LEVEL_CTL register</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXMULTDONE_INTERRUPT</name>
              <description>	Multiple Transmit Transactions Done Interrupt. Set by the UART when the programmed number of transmit transactions have completed. See UART_FIFO_LEVEL_CTL register.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTINT2</name>
          <description>	Extended UART Interrupts</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RXTOUT_ENABLE</name>
              <description>	Rx Time-out Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UNRUNERR_ENABLE</name>
              <description>RX FIFO underflow error Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OVERRUNERR_ENABLE</name>
              <description>	TX FIFO overflow error Interrupt Enable.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXTOUT_CLEAR</name>
              <description>Rx Time-out Interrupt Clear.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>UNRUNERR_CLEAR</name>
              <description>RX FIFO underflow error Interrupt Clear.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>OVERRUNERR_CLEAR</name>
              <description>	TX FIFO overflow error Interrupt Clear.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RXTOUT_TIME_OUT</name>
              <description>	Rx Time-out. Set by the UART when timeout of 4 data frame times without reception, and data received(one or three bytes received,programmable)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>UNRUNERR_ERROR</name>
              <description>RX FIFO underflow error. Set by the UART when an under flow error occurs.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVERRUNERR_ERROR</name>
              <description>	TX FIFO overflow error. Set by the UART when an TX FIFO overflow error occurs.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXTOUT_TNTERRUPT</name>
              <description>	Rx Time-out Interrupt. Set by the UART when RXTOUT flag is set and RXOUT interrupt is enabled.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>UNRUNERR_INTERRUPT</name>
              <description>	RX FIFO underflow error Interrupt. Set by the UART when an under flow error interrupt occurs.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVERRUNERR_INTERRUPT</name>
              <description>	TX FIFO overflow error Interrupt. Set by the UART when an TX FIFO overflow error interrupt occurs.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTBAUD</name>
          <description>	UART Baud rate</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	FDIV</name>
              <description>Fractional divider.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	BAUDDIV</name>
              <description>	Baud rate divider.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	OSR</name>
              <description>	Over-sampling ratio. Valid OSR Range: 6 to 16.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UADVANCE</name>
              <description>	Advance Register. Advances the sample window by 1 cycle. For Debug.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>URETARD</name>
              <description>Retard Register. Retards the sample window by 1 cycle. For Debug.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTFIFO</name>
          <description>	UART FIFO interface</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	RXEMPTY</name>
              <description>	Reception FIFO empty.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	RXFULL</name>
              <description>	Reception FIFO full.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXCOUNT</name>
              <description>	Reception FIFO current count.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXEMPTY</name>
              <description>Transmit FIFO empty.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	TXFULL</name>
              <description>	Transmit FIFO full.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXCOUNT</name>
              <description>Transmit FIFO current count.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	RXMULTIPLEXFERDONECNT</name>
              <description>	Receive Data Count Interrupt. Minimum number of bytes in the receive FIFO before a INT_RX_MULTIPLE_XFER_DONE interrupt is asserted.
Example: A value of 4 would be used to compare to the number of receive transactions (pushes to the Rx FIFO).
Valid Range: 1 to 16</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	TXMULTIPLEXFERDONECNT</name>
              <description>	Transmit Data Count Interrupt. Number of bytes transmitted from the transmit FIFO before a INT_TX_MULTIPLE_XFER_DONE interrupt is asserted.
Example: A value of 4 would be used to compare to the number of completed transfers (pops from the Tx FIFO).
Valid Range: 1 to 16</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SYSCFG</name>
      <version>A0</version>
      <description>System Configuration Located in Power Down Domain.</description>
      <groupName>SYSCFG</groupName>
      <prependToName>				SYSCFG_</prependToName>
      <baseAddress>0x50020000 </baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x01000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SRAMCFGR</name>
          <description>SRAM Configuration Register.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAMECCADDR</name>
              <description>SRAM ECC Error Address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SRAMECCC</name>
              <description>SRAM ECC correction. Set by hardware when one bit ECC error has been detected and corrected when access sram. An interrupt is generated if SRAMECCIE is set.
Cleared by writing 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>SRAMECCD</name>
              <description>SRAM ECC detection. Set by hardware when two bits ECC errors has been detected and corrected when access SRAM. When this bit is set, a NMI is generated.
Cleared by writing 1.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>FLSECCDNMI</name>
              <description>Flash ECC detection Indication. This bit reflect status of ECCD bit of register FLSECCR.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	SRAMECCCIE</name>
              <description>SRAM ECC correction interrupt enable.
0x0: SRAMECCC interrupt disabled
0x1: SRAMECCC interrupt enabled</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SRAMRDECCDIS</name>
              <description>SRAM READ ECC Disable bit.
0x0: SRAM READ ECC function enabled
0x1: SRAM READ ECC function disabled</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SRAMWRECCDIS</name>
              <description>SRAM WRITE ECC Disable bit.
0x0: SRAM WRITE ECC function enabled
0x1: SRAM WRITE ECC function disabled</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMRACR</name>
          <description>SRAM Raw Access Control Register.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAM_RAWACC_EN</name>
              <description>SRAM Raw Access Enable. Set to enable raw access to SRAM.
NOTE: SRAM_ECC_DIS need to set when executing raw access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WR_ECC_RAW</name>
              <description>ECC Raw Value for Write. This field will write to SRAM when bit[31:24] is writing and SRAM_RAWACC_EN is set.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RD_ECC_RAW</name>
              <description>ECC Raw Value for Read. This field store the data from SRAM bit[38:32] when SRAM_RAWACC_EN is set.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMWPKEYR</name>
          <description>SRAM Write Protection Register key register.</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAMWPKEY</name>
              <description>Write pretection key for SRAMWPR to take effect. A value of 0x26 must be written to this address to allow SRAMWPR to take effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMWPR</name>
          <description>SRAM Write Protection Register.</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRAMWP</name>
              <description>SRAM Write Protection. Each bit protect 1Kbyte SRAM area, bit0 correspondint the first 1Kbyte.
This field is set only.
0x0: Corresponding 1K area can be modified
0x1: Corresponding 1K area write protected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>M0IVTRKEYR</name>
          <description>M0 Interrupt Vector Table write key register.</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>M0IVTRKEY</name>
              <description>Write pretection key for M0IVTR to take effect. A value of 0x53 must be written to this address to allow M0IVTR to take effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>M0IVTR</name>
          <description>M0 Interrupt Vector Table Register.</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>IVTBADDR</name>
              <description>Interrupt Vector Table Base Address. This field contains the base address of the interrupt vector table remapping block. IVT_BADDR will be used to replace Address[15:8] if Address[31:8] is equal to 0x0 (Access first 256 byte space). When IVTRAMSEL=0, remapped address will be {Address[31:16],IVTBADDR,Address[7:0]}; When IVTRAMSEL=1, remapped address will be {16'h2000,IVTBADDR,Address[7:0]}.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IVTRAMSEL</name>
              <description>IVT SRAM Selection.
0x0: IVT is located in Flash
0x1: IVT is located in SRAM</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>FLASH</name>
      <version>A0</version>
      <description>	Control (and status) registers for FMC</description>
      <groupName>FLASH</groupName>
      <prependToName>				FLASH_</prependToName>
      <baseAddress>0x50021000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x01000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FLADDR</name>
          <description>	Destination address for flash write or erase operation</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLASHADDR</name>
              <description>Target flash line for write/erase operation. In byte writes, this is the line address of the flash to be written to. In erase modes, it is an address inside the sector to be erased.
NOTE:This register must be written in the correct sequence or the operation will fail.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NVR</name>
              <description>	NVR indication for write/erase operation.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATALR</name>
          <description>	Data (least-significant word)</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	DATAL</name>
              <description>Data (least-significant word). The least-significant, 32-bit word of data that will be written to Flash</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATAMR</name>
          <description>Data (most-significant word)</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATAM</name>
              <description>Data (most-significant word). The most-significant, 32-bit word of data that will be written to Flash</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ECCVALR</name>
          <description>	ECC value</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ECCVAL</name>
              <description>	ECC value. If ECCSTREN = 1, 8bit redundant bits will be stored into ECCVAL during each flash fetch operation.
NOTE:If RDECCEN = 1, this field may be corrected by ECC algorithm.
During programming ECCVAL will be copied to the 8bit redundant bits of a Flash word.
This field will update by syndrome code generated by ECC encoder when DATAM is written with 32-bit data. This field can still be updated by software after hardware update, through this method we can implement raw data program into flash 72bit line.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UNLBWR</name>
          <description>	Flash write unlock register</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	UNLOCK_WRITE</name>
              <description>	Control register to unlock write. A value of 0x55555555 must be written to this address at the correct point in the write sequence or the operation will fail.
Bit 0 will be set if 0x55555555 is written, and will be clear if write operation is started successfully or any other value is written the this register. Other bits read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BWRSTRTR</name>
          <description>Flash write start register</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WRITE_START</name>
              <description>Control register to start a write. A value of 0xAAAAAAAA or 0x502901FF (program to NVR1~NVR3) must be written to this address at the correct point in the write sequence or the operation will fail.
Read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UNLERSR</name>
          <description>Flash erase unlock register</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	UNLOCK_ERASE</name>
              <description>	Control register to unlock a erase operation. A value of 0x66666666 must be written to this address at the correct point in the erase sequence or the operation will fail.
Bit 0 will be set if 0x66666666 is written, and will be clear if erase operation is started successfully or any other value is written the this register. Other bits read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ERSSTRTR</name>
          <description>	Flash erase start register</description>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ERASE_START</name>
              <description>	Control register to commit a sector erase. A value of 0x99999999 or 0x502901FF (Sector erase to NVR1~NVR3) must be written to this address at the correct point in the sector erase sequence or the operation will fail.
Read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSCPR</name>
          <description>	Flash code protection register</description>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CODE_PROT</name>
              <description>	Code Protection / SerialWire Lockout Control
Write a value of 0xF2E11047 to disable the SerialWire interface. Write other values will enable it.
This allows the user program to disable the SerialWire interface to prevent unauthorized debug access to the part.
Bit 0 will be set if 0xF2E11047 is written, and will be clear if any other value is written the this register. Other bits read return zero.
NOTE1: This register does not lock the Flash Memory against read/write/erase by the applications program. Instead what it does is to disable all communications with the debug interface, therefore preventing any external attack. The application code is still able to modify the flash content.
NOTE2: Upon Power-On Reset or Normal Reset the system disables the communication for a small time interval (8192 clock cycles). If the application needs to be protected it is mandatory to set this register with the appropriate code in the beginning of the initialization process and before the internal hardware enable the debug communication.
NOTE3: Reset value depend on NVR4 first 32-bit data. If 0xF2E11047 is programmed into first data of NVR4, reset value is 0x1; otherwise reset value is 0x0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWPKEYR</name>
          <description>	Flash write protection key register</description>
          <addressOffset>0x00000024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WPKEY</name>
              <description>Flash write pretection key for FLSWPx to take effect. A value of 0x12100511 must be written to this address to allow FLSWP0 and FLSWP1 to take effect. Once FLSWPx have taken effect it will be locked for safety.
Bit 0 will be set if 0x12100511 is written, and can only be cleared by system reset. Other bits read return zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWP0R</name>
          <description>Flash write protection 0 register</description>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLSWP0</name>
              <description>	Flash write protection field protect one kilo byte by one bit. Bit0 protect the first KB, bit1 for the second KB, ...
NOTE: This field only take effect after correct key has been written to FLSWPKEYR. And this field can not be modified after taking effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSWP1R</name>
          <description>	Flash write protection 1 register</description>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	FLSWP1</name>
              <description>	Flash write protection field protect one kilo byte by one bit. Bit0 protects the 33th KB, bit1 for the 34th KB, ...
NOTE: This field only take effect after correct key has been written to FLSWPKEYR. And this field can not be modified after taking effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	FLSWPNVR</name>
              <description>	Flash write protection field for NVR sectors. FLSWPNVR[0] protects the first and the second NVR sector, FLSWPNVR[1] protects the third and the forth NVR sector
NOTE: This field only take effect after correct key has been written to FLSWPKEYR. And this field can not be modified after taking effect.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLS_UNLOCK_CTRL_OPR</name>
          <description>	Flash Unlock Control Operation Register</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	UNLOCK_CTRL_OP</name>
              <description>	Flash Control Operation Register Unlock value. 0xACDC_1972 needs to be written in this register to unlock the Control Operation Register access. When this register is read, it returns the state of the lock:
0: The Control Operation Register is locked. The CHIPSEL bit of FLASH_CTRL_OPR cannot be written.
1: The Control Operation Register is unlocked. The CHIPSEL bit of FLASH_CTRL_OPR can be written.
NOTE: After each write to the third byte of FLASH_CTRL_OPR register, the state of the lock is cleared and the pattern needs to be written again to allow a new configuration of the register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL_OPR</name>
          <description>	Flash Control Operation Register</description>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	BYTESEL</name>
              <description>Byte selection of the write operation. Set to 1 indicated the corresponding byte will be programmed.
NOTE: BYTESEL's set bits must be continuous, otherwise will cause unintentional chaos. ex. 9'b11100_0000, 9'b00011_1110, 9'b00000_0011, 9'b00000_1000 are valid setting, 9'b01011_1111, 9'b01001_0000 are not allowed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHIPSEL</name>
              <description>Byte selection of the write operation. Set to 1 indicated the corresponding byte will be programmed.
NOTE: BYTESEL's set bits must be continuous, otherwise will cause unintentional chaos. ex. 9'b11100_0000, 9'b00011_1110, 9'b00000_0011, 9'b00000_1000 are valid setting, 9'b01011_1111, 9'b01001_0000 are not allowed.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	ECCSTREN</name>
              <description>ECC Store Enable. When set, 8bit redundant bits will be stored into ECCVAL during every flash fetch operation.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	PROGVREAD</name>
              <description>	Program Margin Read Enable. Set to enable margin read for program cell verification.
NOTE:After set PROGVREAD, must wait one cycle to issued new flash read to execute program margin read.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERSVREAD</name>
              <description>	Erase Margin Read Enable. Set to enable margin read for erase cell verification.
NOTE:After set ERSVREAD, must wait one cycle to issued new flash read to execute erase margin read.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	FRWS</name>
              <description>	Flash Read Wait State Number. Number of wait states used in the reading process. Each read from flash memory will take number of cycles equal to 1+FRWS to complete.
NOTE:FRWS = 0 is adequate for normal read. When in margin read, make sure (1 + FRWS ) * Fhclk is slower than 225ns.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSECCR</name>
          <description>	Flash ECC Register</description>
          <addressOffset>0x00000038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	ADDRECC</name>
              <description>	ECC fail double-word address offset. In case of ECC error or ECC correction detected, this bitfield contains double-word offset (multiple of 64 bits) to Main Flash memory or to NVR1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	NVRFECC</name>
              <description>	NVR ECC fail. This bit indicates that the ECC error correction or double ECC error detection is located in the NVR Flash memory.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RDECCEN</name>
              <description>	Read ECC correction and detection Enable. ECC correction and detection will only be enabled when RDECCEN is set.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ECCCIE</name>
              <description>	ECC correction interrupt enable.
0x0: ECCC interrupt disabled
0x1: ECCC interrupt enabled</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WPVIOLIE</name>
              <description>	Write Protection Violation interrupt enable.
0x0: WPVIOL interrupt disabled
0x1: WPVIOL interrupt enabled</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	WPVIOL</name>
              <description>Write Protection Violation. Set by hardware when flash write protection has been violated. An interrupt is generated if WPVIOLIE is set.
Cleared by writing 1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>	ECCC</name>
              <description>ECC correction. Set by hardware when one ECC error has been detected and corrected. An interrupt is generated if ECCIE is set.
Cleared by writing 1.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>ECCD</name>
              <description>ECC detection. Set by hardware when two ECC errors has been detected. When this bit is set, a NMI is generated.
Cleared by writing 1.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TRIM</name>
          <description>	Flash Trim Register</description>
          <addressOffset>0x0000003C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>OSC_TRIM</name>
              <description>Oscillator Trim Value. This register will be automatically populated with the value stored in the least significant bits of NVR sector 1 (@0002_0000).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSSTATR</name>
          <description>Flash Status Register</description>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>OPBSY</name>
              <description>	Flash operatoin busy indication. Reading 1 indicate program/erase operation busy.
NOTE: In the SWD erase operation, OPBSY may be started 256 cycles later after command issued.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL0R</name>
          <description>	Flash Operation Time Length 0 Register</description>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	SERTL</name>
              <description>	Sector Erase Time Length. This register define the duration of sector erase operation in number of 4M oscillator's cycles. Default duration is 4.5ms</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PGTL</name>
              <description>Program Time Length. This register define the duration of byte program operation in number of 4M oscillator's cycles. Default duration is 6750ns</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FLSOPTL1R</name>
          <description>	Flash Operation Time Length 1 Register</description>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	MERTL</name>
              <description>Chip Mass Erase Time Length. This register define the duration of chip mass erase operation in number of 4M oscillator's cycles. Default duration is 30ms</description>
              <bitOffset>0</bitOffset>
              <bitWidth>17</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATAFIELDCTRL</name>
          <description>Flash data field with optional ecc register.</description>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATAECCDIS</name>
              <description>0x0: ECC for data field enabled
0x1: ECC for data field disabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DATAFIELDADDR</name>
              <description>Flash data field base address. Flash data field base address. DATAFIELDADDR = 0 represent DATA field start at the first NVR sector, DATAFIELDADDR = 95 represent DATA field start at the last NVR sector,and ends at the end address of the 96th sector</description>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER0</name>
      <version>A0</version>
      <description>General purpose timer 0 registers</description>
      <groupName>TIMER0</groupName>
      <prependToName>				TIMER0_</prependToName>
      <baseAddress>0x50022000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>COUNT</name>
          <description>Timer Counter Register.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT</name>
              <description>Count. Initial counter value. The timer will count from this value to 0xFFFFFFFF and roll over to 0x00000000. At this point it will generate an interrupt if enabled. The interrupt routine is responsible for reloading the value if needed as this timer does not auto-reload the original content.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <description>Timer Control Register.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>Enable. This bit starts/stops the timer: &lt; br&gt; 1 = Timer Running &lt; br&gt; 0 = Timer Inactive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER1</name>
      <version>A0</version>
      <description>General purpose timer 1 registers</description>
      <groupName>TIMER1</groupName>
      <prependToName>				TIMER1_</prependToName>
      <baseAddress>0x50022008</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>COUNT</name>
          <description>Timer Counter Register.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT</name>
              <description>Count. Initial counter value. The timer will count from this value to 0xFFFFFFFF and roll over to 0x00000000. At this point it will generate an interrupt if enabled. The interrupt routine is responsible for reloading the value if needed as this timer does not auto-reload the original content.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <description>Timer Control Register.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>Enable. This bit starts/stops the timer: &lt; br&gt; 1 = Timer Running &lt; br&gt; 0 = Timer Inactive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER2</name>
      <version>A0</version>
      <description>General purpose timer 2 registers</description>
      <groupName>TIMER2</groupName>
      <prependToName>				TIMER2_</prependToName>
      <baseAddress>0x50022010</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>COUNT</name>
          <description>Timer Counter Register.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT</name>
              <description>Count. Initial counter value. The timer will count from this value to 0xFFFFFFFF and roll over to 0x00000000. At this point it will generate an interrupt if enabled. The interrupt routine is responsible for reloading the value if needed as this timer does not auto-reload the original content.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <description>Timer Control Register.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>Enable. This bit starts/stops the timer: &lt; br&gt; 1 = Timer Running &lt; br&gt; 0 = Timer Inactive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WDT1</name>
      <version>A0</version>
      <description>The watchdog timer that is local to VERNE MCU</description>
      <groupName>WDT1</groupName>
      <prependToName>		WDT1_</prependToName>
      <baseAddress>0x50022018</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0008</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CFG</name>
          <description>Config.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA</name>
              <description>WDT Enable. This bit can be asserted but it cannot be de-asserted. It means that once the WDT is enabled it cannot be turned off until a Reset or Power-On Reset occurs.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSTEN</name>
              <description>Reset enable. If enabled a WDT time-out will force the microcontroller to reset. This bit can be asserted but it cannot be de-asserted.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSTFLAG</name>
              <description>Reset flag. This flag is set by the system at the initialization if the initialization was caused by a reset triggered by the WDT. The bit can be cleared by the application.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRESET</name>
              <description>Preset. Defines the watchdog timeout period.
It means that the WDT internal counter will count from 0 to the prescaler value at the system clock speed and trigger if not cleared. For instance, a system running from a 30MHz Crystal with WDTPRES[1I0] = 10 will trigger the WDT after approximately 0.14 seconds if not cleared properly and in time by the application.
0x0: 2^13 / System Clock
0x1: 2^19 / System Clock
0x2: 2^22 / System Clock
0x3: 2^32 / System Clock</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>KEY</name>
          <description>Key. Writing the sequence CLEAR, KEY0, KEY1 to this register will clear (pet) the watchdog - preventing it from timing out and resetting the system.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>KEY</name>
              <description>Key. To clear the WDT counting the following words must be written in this order and without any other instruction between then:
0x3C570001
0x007F4AD6</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CRC</name>
      <version>A0</version>
      <description>CRC32 Registers.</description>
      <groupName>CRC</groupName>
      <prependToName>				CRC_</prependToName>
      <baseAddress>0x50022100</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0010</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CRCDR</name>
          <description>CRC Data Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CRCDATA0</name>
              <description>CRC data bits. This register is used to write new data to the CRC calculator.
When read it returns the previous CRC calculation result or the data write to CRCINIT
If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>	CRCDATA1</name>
              <description>CRC data bits. This register is used to write new data to the CRC calculator.
When read it returns the previous CRC calculation result or the data write to CRCINIT
If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>	CRCDATA2</name>
              <description>	CRC data bits. This register is used to write new data to the CRC calculator.
When read it returns the previous CRC calculation result or the data write to CRCINIT
If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>dual</access>
            </field>
            <field>
              <name>	CRCDATA3</name>
              <description>	CRC data bits. This register is used to write new data to the CRC calculator.
When read it returns the previous CRC calculation result or the data write to CRCINIT
If the data size is less than 32 bits, only the least significant bits will be take effect. ex. byte write to field [15:8] will be ignored, half-word write to bit field [31:16] will be ignored</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CRCIR</name>
          <description>	CRC Initial Value Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CRCINIT</name>
              <description>CRC initial value. This register is used to write the CRC initial value. The data write to this register will be stored in CRCDATA until it replaced by new calculated result
NOTE: This register can only be writen by word</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32 </bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CRCCR</name>
          <description>	CRC Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>REVIN</name>
              <description>Reverse input data. These bits control the reversal of the bit order of the input data
0x0: Bit order not affected
0x1: Bit reversal done by byte
0x2: Bit reversal done by half-word
0x3: Bit reversal done by word</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	REVOUT</name>
              <description>Reverse output data. This bit controls the reversal of the bit order of the output data.
0x0: Bit order not affected
0x1: Bit order is reversed</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>