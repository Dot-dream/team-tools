              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXDONE_INTERRUPT</name>
              <description>	Rx Data ready Interrupt. Set by the UART when Rx data is ready</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVRUNERR_INTERRUPT</name>
              <description>RX FIFO overflow error Interrupt. Set by the UART when an overrun error occurs</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FRMERR_INTERRUPT</name>
              <description>Framing error Interrupt. Set by the UART when a framing error occurs</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PRTYERR_INTERRUPT</name>
