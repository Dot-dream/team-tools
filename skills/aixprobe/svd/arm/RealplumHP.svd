              <description>	Channel4 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADCVREFSELCH5</name>
              <description>Channel5 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	ADCVREFSELCH6</name>
              <description>	Channel6 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADCVREFSELCH7</name>
              <description>	Channel7 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADCVREFSELCH8</name>
              <description>Channel8 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	ADCVREFSELCH9</name>
              <description>	Channel9 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	ADCVREFSELCH10</name>
              <description>	Channel10 adc vref select. Refer to ADC_VREF_SEL_CH1.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SARINT</name>
          <description>	SAR Interrupts</description>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INT_CONV_DONE_ENA</name>
              <description>Convert Done Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1  </bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_TRIG_CLASH_ENA</name>
              <description>	Trigger Clash Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INT_CONV_DONE_CLR</name>
              <description>	Convert Done Interrupt Clear.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>INT_TRIG_CLASH_CLR</name>
              <description>	Trigger Clash Interrupt Clear.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>	CONV_DONE</name>
              <description>	Convert Done. Set by the SAR when an conversion is done.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TRIG_CLASH</name>
              <description>Trigger Clash. Set by the SAR when new trigger issued when previous has not finished.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	INT_CONV_DONE</name>
              <description>	Convert Done Interrupt. Set by the SAR when an convert done occurs</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>INT_TRIG_CLASH</name>
              <description>Trigger Clash Interrupt. Set by the SAR when TRIG_CLASH is high and INT_TRIG_CLASH_ENA is set</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SARCLKDIV</name>
          <description>SAR CLOCK DIVIDE</description>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	SARCLKDIV</name>
              <description>	SAR CLOCK DIVIDE. Divide ration is (SAR_CLK_DIV+1)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SPI</name>
      <version>A0</version>
      <description>SPIM Interface registers</description>
      <groupName>SPI</groupName>
      <prependToName>			SPI_</prependToName>
      <baseAddress>0x50015000 </baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SPIRXDATA</name>
          <description>	Serial Peripheral Rx Data Register</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	RXDATA</name>
              <description>	Rx Data buffer. Received Data Register.
A read from this register will return data from current read pointer on the receive FIFO.
A read from this register will increment the read pointer on the receive FIFO.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPITXDATA</name>
          <description>	Serial Peripheral Tx Data Register</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	TXDATA</name>
              <description>	Tx Data buffer. Transmit Data Register.
Used for data that is to be transmitted.
A write to this register will place data into the transmit FIFO and increment the write pointer for the transmit FIFO.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPICTRL</name>
          <description>	Serial Peripheral Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ENA_REQ</name>
              <description>	SPI enable request.
Enables the SPI interface.
When SPI enable is deasserted the Tx and Rx FIFO's are still operable.
Careful- If data is present in the Tx FIFO prior to enabling SPI, then once SPI is enabled it will begin transmitting the data present in the Tx FIFO.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	ENA_STS</name>
              <description>SPI enable status. Status of SPI enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	SPR</name>
              <description>	Standard clock divider selection. Please refer to SPRE register for system clock.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CPHA</name>
              <description>	SPI clock phase.
0x0: Data is captured on clock transition from base and data is propagated on the clock transition to base
0x1: Data is captured on clock transition to base and data is propagated on the clock transition from base</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	CPOL</name>
              <description>	SPI clock polarity (Motorola SPI Frame Format).
0x0: The base value of the clock is zero
0x1: The base value of the clock is one</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	SCKEXT</name>
              <description>	Extended clock divider.
SPR - Standard Clock Rate Divider Select
SPRE (SCKEXT) - Extended Clock Rate Select Bits
{SPRE, SPR} = Clock Divide Result
{00, 00}: System Clock / 2
{00, 01}: System Clock / 4
{00, 10}: System Clock / 8
{00, 11}: System Clock / 32
{01, 00}: System Clock / 64
{01, 01}: System Clock / 16
{01, 10}: System Clock / 128
{01, 11}: System Clock / 256
{10, 00}: System Clock / 512
{10, 01}: System Clock / 1024
{10, 10}: System Clock / 2048
{10, 11}: System Clock / 4096
{11, xx}: Reserved</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ICNT</name>
              <description>	Interrupt counter bits.
0x0: Interrupt is set after every completed transfer
0x1: Interrupt is set after two completed transfers
0x2: Interrupt is set after three completed transfers
0x3: Interrupt is set after four completed transfers</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LPBK</name>
              <description>	Port wired-OR mode bit.
0x0: master_in = miso
0x1: master_in = mosi</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	FIFOSOFTRESET</name>
              <description>FIFO Soft Reset. FIFO Soft Reset bit (active high). Writing a one here will clear the FIFO pointers.
This bit automatically clears to zero.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPISTATUS</name>
          <description>	Serial Peripheral Status Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	XFERCNT</name>
              <description>	Completed Transfer Count. Signal is set after a programmable amount of completed transfer. See SPI_CTRL register field ICNT.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXFIFOUF</name>
              <description>Reception FIFO underflow.
0x0: underflow inactive
0x1: underflow active</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	TXFIFOOF</name>
              <description>	Transmit FIFO overflow.
0x0: overflow inactive
0x1: overflow active</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXFIFOEMPTY</name>
              <description>	Reception FIFO empty.
0x0: FIFO is NOT empty
0x1: FIFO is empty</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	RXFIFOFULL</name>
              <description>Reception FIFO full.
0x0: FIFO is NOT full
0x1: FIFO is full</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	TXFIFOEMPTY</name>
              <description>	Transmit FIFO empty.
0x0: FIFO is NOT empty
0x1: FIFO is empty</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXFIFOFULL</name>
              <description>	Transmit FIFO full.
0x0: FIFO is NOT full
0x1: FIFO is full</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXFIFOCOUNT</name>
              <description>Reception FIFO Count. Signal indicates active number of bytes in the FIFO. Increments on Push. Decrements on Pop.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXFIFOCOUNT</name>
              <description>ransmit FIFO Count. Signal indicates active number of bytes in the FIFO. Increments on Push. Decrements on Pop.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIINTSTATUS</name>
          <description>SPI Interrupt Status</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INTXFERCNT</name>
              <description>SPI Transfer Count Interrupt. Interrupt is set after a programmable amount of completed transfer. See SPI_CTRL register field ICNT.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	INTRXFIFOUF</name>
              <description>	Reception FIFO Underflow Interrupt. Interrupt is set when Receive FIFO is empty and a read transaction occurs. (READ COLLISION)</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	INTTXFIFOOF</name>
              <description>Transmit FIFO Overflow Interrupt. Interrupt is set when Transmit FIFO is full and a write transaction occurs. (WRITE COLLISION)</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIINTENABLE</name>
          <description>	SPI Interrupt Enable</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INTXFERCNTENA</name>
              <description>SPI Transfer Count Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INTRXFIFOUFENA</name>
              <description>	Reception FIFO Underflow Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INTTXFIFOOFENA</name>
              <description>Transmit FIFO Overflow Interrupt Enable.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIINTCLEAR</name>
          <description>	SPI Interrupt Clear</description>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INTXFERCNTCLR</name>
              <description>SPI Transfer Count Interrupt.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>INTRXFIFOUFCLR</name>
              <description>Reception FIFO Underflow Interrupt.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>INTTXFIFOOFCLR</name>
              <description>Transmit FIFO Overflow Interrupt.
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UART0</name>
      <version>A0</version>
      <description>UART Interface registers</description>
      <groupName>	UART0</groupName>
      <prependToName>				UART0_</prependToName>
      <baseAddress>0x50015400</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x0400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DATA</name>
          <description>Data</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	BYTE</name>
              <description>	Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>	dual</access>
            </field>
            <field>
              <name>DUMMY0</name>
              <description>	Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>	dual</access>
            </field>
            <field>
              <name>DUMMY1</name>
              <description>	Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>	dual</access>
            </field>
            <field>
              <name>DUMMY2</name>
              <description>	Data. Used for both received data and data that is to be transmitted.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>	dual</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTDATARECEIVESTATUS</name>
          <description>	Data Receive Status</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	FRAMEERROR</name>
              <description>	Framing Error. When this bit is set to 1, it indicates that the received byte did not have a valid stop bit (a valid stop bit is 1).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	PARITYERROR</name>
              <description>	Parity Error. When this bit is set to 1, it indicates that the parity of the received data character has parity error.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>	BREAKERROR</name>
              <description>Break Error. This bit is set to 1 if a break condition was detected, indicating that the received data input was held LOW for longer than a full-word transmission time (defined as start, data, parity, and stop bits).</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSGCTRL</name>
          <description>	Message control</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>	ENABLE</name>
              <description>	Enable. Set to enable the UART</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	ENABLE_STS</name>
              <description>Enable status. Status of UART enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>UFIFOSOFTRESET</name>
              <description>	FIFO SOFT RESET. Resets FIFO pointers to zero and initializes FIFO contents to zero
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RXXFERCNTCLR</name>
              <description>	RX Transfer Counter Clear. Clear RX Multi Transfer Counter to zero
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TXXFERCNTCLR</name>
              <description>	TX Transfer Counter Clear. Clear TX Multi Transfer Counter to zero
Autoclear: includes a synchronous reset signal which clears the register on the cycle following write.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SIZE</name>
              <description>	Transmission word size.
0x0: 5-bit
0x1: 6-bit
0x2: 7-bit
0x3: 8-bit</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STOP</name>
              <description>	Stop bit control.
0x0: One stop bit
0x1: If a 5-bit transmission it selects 1.5 stop bits, otherwise 2 stop bits (6, 7 &amp; 8 bits)</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	PARENA</name>
              <description>Parity enable. Set to enable parity (see PARODD for odd/even)</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PARODD</name>
              <description>	Odd parity.
0x0: ODD Parity
0x1: EVEN parity</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STICKENA</name>
              <description>	Sticky parity enable. Set to enable sticky parity</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	BREAKENA</name>
              <description>Break enable. Set to force transmission of zero (for a break condition)</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>	LOOPENA</name>
              <description>	Loopback enable. Set to enable loopback</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UARTINT</name>
          <description>	UART Interrupts</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RXDONE_ENABLE</name>
              <description>Rx Data ready Interrupt Enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OVRUNERR_ENABLE</name>
              <description>	RX FIFO overflow error Interrupt Enable.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FRMERR_ENABLE</name>
              <description>	Framing error Interrupt Enable.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRTYERR_ENABLE</name>
              <description>	Parity Error Interrupt Enable.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BREAKKERR_ENABLE</name>
              <description>	Break Error Interrupt Enable.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXDONE_ENABLE</name>
              <description>Transmission done Interrupt Enable.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
