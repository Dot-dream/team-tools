          <resetValue>0x4</resetValue>
          <fields>
            <field>
              <name>PWMSYNCEN</name>
              <description>PWM Synchronization functio Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
