<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd" >
  <vendor>Geneal MCU Ltd.</vendor>                          <!-- device vendor name -->
  <vendorID>TC</vendorID>                                         <!-- device vendor short name -->
  <name>TC80_VXX</name>                                          <!-- name of part-->
  <series>ARMCM0</series>                                         <!-- device series the device belongs to -->
  <version>1.2</version>                                          <!-- version of this description, adding CMSIS-SVD 1.1 tags -->
  <description>ARM 32-bit Cortex-M0 Microcontroller based device, CPU clock up to 32MHz, etc. </description>
  <licenseText>
    THIS SOFTWARE IS PROVIDED "AS IS".  NO WARRANTIES, WHETHER EXPRESS, IMPLIED\n
    OR STATUTORY, INCLUDING, BUT NOT LIMITED TO, IMPLIED WARRANTIES OF\n
    MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE APPLY TO THIS SOFTWARE.\n
    ARM SHALL NOT, IN ANY CIRCUMSTANCES, BE LIABLE FOR SPECIAL, INCIDENTAL, OR\n
    CONSEQUENTIAL DAMAGES, FOR ANY REASON WHATSOEVER.
  </licenseText>
  <cpu>                                                           <!-- details about the cpu embedded in the device -->
    <name>CM0</name>
    <revision>r0p0</revision>
    <endian>little</endian>
    <mpuPresent>false</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>2</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>                            <!-- byte addressable memory -->
  <width>32</width>                                               <!-- bus width is 32 bits -->
  <!-- default settings implicitly inherited by subsequent sections -->
  <size>32</size>                                                 <!-- this is the default size (number of bits) of all peripherals
                                                                       and register that do not define "size" themselves -->
  <access>read-write</access>                                     <!-- default access permission for all subsequent registers -->
  <resetValue>0x00000000</resetValue>                             <!-- by default all bits of the registers are initialized to 0 on reset -->
  <resetMask>0xFFFFFFFF</resetMask>                               <!-- by default all 32Bits of the registers are used -->

  <peripherals>
    <peripheral>
      <name>TIM0</name>
      <version>1.0</version>
      <description>16 bits Timer / Counter</description>
      <groupName>TIMER</groupName>
      <baseAddress>0x49000000</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>

      <interrupt>
        <name>TIM0</name>
        <description>Timer0 interrupt</description>
        <value>3</value>
      </interrupt>

      <registers>
        <register>
          <name>CR</name>
          <description>Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x30F</resetMask>

          <fields>
            <field>
              <name>CEN</name>
              <description>Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Timer is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Timer is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>MMS</name>
              <description>Master mode select</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Master_Mode</name>
                  <description>Select master mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Slave_Mode</name>
                  <description>Select slave mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>MODE</name>
              <description>Running mode select</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Count_Mode</name>
                  <description>Timer counts</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Capture_Mode</name>
                  <description>Timer capture input signal</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Compare_Mode</name>
                  <description>Timer campare and output signal</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>One_Pulse_Mode</name>
                  <description>Timer output one pulse signal</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
             <name>ARPE</name>
             <description>Auto reload pre-enable</description>
             <bitRange>[8:8]</bitRange>
             <access>read-write</access>
             <enumeratedValues>
               <enumeratedValue>
                 <name>Disable</name>
                 <description>Auto pre-reload is not used</description>
                 <value>0</value>
               </enumeratedValue>
               <enumeratedValue>
                 <name>Enable</name>
                 <description>Auto pre-reload is used</description>
                 <value>1</value>
               </enumeratedValue>
             </enumeratedValues>
            </field>

            <field>
              <name>CCPE</name>
              <description>Capture/Compare pre-reload control</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Capture/Compare pre-reload is not used</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Capture/Compare pre-reload is used</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

          </fields>
        </register>

        <register>
          <name>CCCR</name>
          <description>Capture/Compare control register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF3FF</resetMask>

          <fields>
            <field>
              <name>CAPF</name>
              <description>Capture filter configuration</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>CAPEG</name>
              <description>Break edge select</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Posedge</name>
                  <description>Poseedge active</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Negedge</name>
                  <description>Negedge active</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bothedge</name>
                  <description>Posedge and negedge both active</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>No_Active</name>
                  <description>No edge active</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OCxE</name>
              <description>OCx output enable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Compare output disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Compare output enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>OCxNE</name>
              <description>OCxN output enable</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Compare output disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Compare output enable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>OCxP</name>
              <description>OCx output polarity select</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Equal</name>
                  <description>Select output same as ref signal</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Oppsite</name>
                  <description>Select output oppsite as ref signal</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>OCxNP</name>
              <description>OCxN output polarity select</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Equal</name>
                  <description>Select output same as ref signal</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Oppsite</name>
                  <description>Select output oppsite as ref signal</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

          </fields>
        </register>

        <register>
          <name>BCR</name>
          <description>Break control register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFF1F</resetMask>

          <fields>
            <field>
              <name>BRKEN</name>
              <description>Break enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Break disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Break enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>BRKEG</name>
              <description>Break edge select</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Posedge</name>
                  <description>Poseedge active</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Negedge</name>
                  <description>Negedge active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>OCxBP</name>
              <description>OCx output polarity select</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Select low level after break</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Select high level after break</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>OCxNBP</name>
              <description>OCxN output polarity select</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Select low level after break</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Select high level after break</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>MOE</name>
              <description>Main output enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>OCx and OCxN outputs are disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>OCx and OCxN outputs are enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>AOE</name>
              <description>Automatic output enable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>MOE can be set only by software</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>MOE can be set by software or automatically if break input is not be active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>BRKF</name>
              <description>Break filter configutaion</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>

          </fields>
        </register>

        <register>
          <name>TCR</name>
          <description>Trigger control register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFF03</resetMask>

          <fields>
            <field>
              <name>TSEL</name>
              <description>Trigger souce select</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Both</name>
                  <description>Compare/Capture and Count interrupt both active trigger</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CC</name>
                  <description>Compare/Capture interrupt active trigger</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Count</name>
                  <description>Count interrupt active trigger</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Trigger disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>TDIV</name>
              <description>Trigger divsion</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>

          </fields>
        </register>

        <register>
          <name>IER</name>
          <description>Interrupt enable register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF</resetMask>

          <fields>
            <field>
              <name>CNTIE</name>
              <description>Count interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Count interrupt enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Count interrupt disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>CCIE</name>
              <description>Compare/Capture interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Compare/Capture interrupt enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Compare/Capture interrupt disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>BIE</name>
              <description>Break interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Break interrupt enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Break interrupt disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>TIE</name>
              <description>Trigger interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Trigger interrupt enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Trigger interrupt disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

          </fields>
        </register>

        <register>
          <name>IFR</name>
          <description>Interrupt flag register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xF</resetMask>

          <fields>
            <field>
              <name>CNTIF</name>
              <description>Count interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No_Overflow</name>
                  <description>Overflow interrupt has no occured</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Overflow_Occured</name>
                  <description>Overflow interrupt has occured</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>CCIF</name>
              <description>Compare/Capture interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No_CC</name>
                  <description>Compare/Capture interrupt has no occured</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CC_Occured</name>
                  <description>Compare/Capture interrupt has occured</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>BIF</name>
              <description>Break interrupt flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No_Break</name>
                  <description>Break interrupt has no occured</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Break_Occured</name>
                  <description>Break interrupt has occured</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>TIF</name>
              <description>Trigger interrupt flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No_Trigger</name>
                  <description>Trigger interrupt has no occured</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger_Occured</name>
                  <description>Trigger interrupt has occured</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

          </fields>
        </register>

        <register>
          <name>CNT</name>
          <description>The counter register reflects the actual value of the timer/counter</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF</resetMask>
        </register>

        <register>
          <name>DIV</name>
          <description>The DIV register set run frequency as PCLK/DIV</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF</resetMask>
        </register>
        
        <register>
          <name>ARR</name>
          <description>The ARR register stroes the value to be loaded in the actual auto-reload register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000FFFF</resetValue>
          <resetMask>0xFFFF</resetMask>
        </register>
        
        <register>
          <name>CCR</name>
          <description>The CCR register stores the Value for Compare/Capture happend</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF</resetMask>
        </register>

        <register>
          <name>DTG</name>
          <description>Dead time generate register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF</resetMask>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>TIM1</name>
      <version>1.0</version>
      <description>16 bits Timer / Counter</description>
      <groupName>TIMER</groupName>
      <baseAddress>0x49000400</baseAddress>
      <size>32</size>
      <access>read-write</access>

      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>

      <interrupt>
        <name>TIM1</name>
        <description>Timer1 interrupt</description>
        <value>4</value>
      </interrupt>

      <registers>
        <register>
          <name>CR</name>
          <description>Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x30F</resetMask>

          <fields>
            <field>
              <name>CEN</name>
              <description>Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Timer is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Timer is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <field>
              <name>MMS</name>
              <description>Master mode select</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
