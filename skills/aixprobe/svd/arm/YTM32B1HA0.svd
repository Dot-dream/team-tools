          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NCIF</name>
              <description>Non-Correctable error interrupt flag. NCIF flag is kept when software reset but cleared when POR.
  0b - Channel n Non-Correctable Error interrupt not detected
  1b - Channel n Non-Correctable Error interrupt detected</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCIF</name>
              <description>Single Correctable error interrupt flag. SCIF flag is kept when software reset but cleared when POR.
  0b - Channel n Single Correctable Error interrupt not detected
  1b - Channel n Single Correctable Error interrupt detected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
