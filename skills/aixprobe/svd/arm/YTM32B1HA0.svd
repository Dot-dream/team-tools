              <name>DBSW01</name>
              <description>Channel 0 and 1 is used to generate the double switch signal.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
