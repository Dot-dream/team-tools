        <register>
        <name>SPNDST</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATLFT</name>
              <description>Suspended data left indicator, in 64 bit. Value 0 indicate the left data is less than 64 bits.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPNDBUF</name>
              <description>Suspended buffer indicator.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Buffer 0 is suspended.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Buffer 1 is suspended.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Buffer 2 is suspended.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Buffer 3 is suspended.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SPND</name>
              <description>Suspend state indicator.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No suspend occurs.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Suspend occurs.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>RBCS</name>
          <description></description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>RXCTR</name>
              <description>RxFIFO read data counter, in 32 bit. Value 1 indicate 4 bytes data have been read out from RxFIFO. This counter is incremented by the number (RBCS[WM]+1). This filed can be cleared by MCFG[RXFCLR].</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXFL</name>
              <description>Current RxFIFO data number indicator, in 32 bit. Value 1 indicate current RxFIFO data number is 4 bytes. This filed can be cleared by MCFG[RXFCLR].</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>WM</name>
              <description>RxFIFO watermark, fill lever &gt; watermark will trigger the DMA or interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>TBCS</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>TXCTR</name>
              <description>TxFIFO write data counter, in 32 bit. Value 1 indicate 4 bytes data have been written into TxFIFO. This filed can be cleared by MCFG[TXFCLR].</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TXFL</name>
              <description>Current TxFIFO data number indicator, in 32 bit. Value 1 indicate current TxFIFO data number is 4 bytes. This filed can be cleared by MCFG[TXFCLR].</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>WM</name>
              <description>TxFIFO watermark, (max TxFIFO depth - fill lever) &gt; watermark will trigger the DMA or interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>APBCFG</name>
          <description></description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SEQID</name>
              <description>Select the LUT sequence when access to the serial flash by APB. A write to this field will trigger the transaction.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PAREN</name>
              <description>Enable/disable the parallel mode when access to serial flash by APB.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Parallel mode is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Parallel mode is enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATSZ</name>
              <description>Data size of APB write/read access to the serial flash, in 8 bit. Value 1 indicate the write/read data is one byte. When this field is value 0, the write/read data size is up to the operand of the write/read LUT command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>AHBCFG</name>
          <description></description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00002000</resetValue>
           <fields>
            <field>
              <name>SEQID</name>
              <description>Select the LUT sequence when access to the serial flash by AHB.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PAREN</name>
              <description>Enable/disable the parallel mode when access to serial flash by AHB.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Parallel mode is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Parallel mode is enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RESPTO</name>
              <description>Max wait time for AHB access. This field can only be changed when MEN[EN]=0. AHB write/read access to the serial flash will timeout if data not transmitted or no data received after RESPTO*1024 AHB clock cycles.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF0CFG</name>
          <description></description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000003</resetValue>
           <fields>
            <field>
              <name>HPEN</name>
              <description>Buffer 0 high priority enable/disable control.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Buffer 0 is same as other buffers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Buffer 0 has higher priority than other buffers, access to buffer 0 will result in other buffers' access being suspended.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATSZ</name>
              <description>Data size of AHB write/read access to the serial flash, in 64 bit. Value 1 indicate the write/read data is 8 bytes. When this field is value 0, the write/read data size is up to the operand of the write/read LUT command.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MSTRID</name>
              <description>Define the AHB master ID which can access to the buffer 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF1CFG</name>
          <description></description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
           <fields>
            <field>
              <name>DATSZ</name>
              <description>Data size of AHB write/read access to the serial flash, in 64 bit. Value 1 indicate the write/read data is 8 bytes. When this field is value 0, the write/read data size is up to the operand of the write/read LUT command.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MSTRID</name>
              <description>Define the AHB master ID which can access to the buffer 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF2CFG</name>
          <description></description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
           <fields>
            <field>
              <name>DATSZ</name>
              <description>Data size of AHB write/read access to the serial flash, in 64 bit. Value 1 indicate the write/read data is 8 bytes. When this field is value 0, the write/read data size is up to the operand of the write/read LUT command.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MSTRID</name>
              <description>Define the AHB master ID which can access to the buffer 2.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF3CFG</name>
          <description></description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x80000000</resetValue>
           <fields>
            <field>
              <name>ALLACC</name>
              <description>Buffer 3 all master access enable/disable control.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Buffer 3 can only be accessed by matched AHB master that defined by BUF3CFG[MSTRID].</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Buffer 3 can be accessed by all AHB masters.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATSZ</name>
              <description>Data size of AHB write/read access to the serial flash, in 64 bit. Value 1 indicate the write/read data is 8 bytes. When this field is value 0, the write/read data size is up to the operand of the write/read LUT command.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MSTRID</name>
              <description>Define the AHB master ID which can access to the buffer 3, this field is meaningless when BUF3CFG[ALLACC]=1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF0IND</name>
          <description></description>
          <addressOffset>0x3c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>TPIND0</name>
              <description>Define the buffer 0 space range, sram address from 0 to (BUF0IND[TPIND0]-1) is the buffer 0 space.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF1IND</name>
          <description></description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>TPIND1</name>
              <description>Define the buffer 1 space range, sram address from BUF0IND[TPIND0] to (BUF1IND[TPIND1]-1) is the buffer 1 space.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>BUF2IND</name>
          <description></description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>TPIND2</name>
              <description>Define the buffer 2 space range, sram address from BUF1IND[TPIND1] to (BUF2IND[TPIND2]-1) is the buffer 2 space.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FACFG</name>
          <description></description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000303</resetValue>
           <fields>
            <field>
              <name>DODLY</name>
              <description>Data output delay control in DDR mode.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Data output is aligned to the clock edge in DDR mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Data output is 1/4 serial flash clock cycle later than the clock edge in DDR mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CSHT</name>
              <description>Define the chip select signal rises hold time that controls the chip select signal rises opportunity after clock output end.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CSST</name>
              <description>Define the chip select signal falls setup time that controls the chip select signal falls opportunity before clock output start.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>SFA</name>
          <description></description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SFA</name>
              <description>Define the serial flash access address. It's only used by APB access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

