                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Invert fault 1 input. Low level signal is regarded as fault signal.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>F0POL</name>
