            </field>
          </fields>
        </register>


                                <register>
        <name>ERINFO5_ADDR</name>
          <description></description>
          <addressOffset>0x160</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field contains the faulting system address of the last recorded ECC event on on-chip memories.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO5_SYND</name>
          <description></description>
          <addressOffset>0x164</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>SYNDROME</name>
              <description>This field contains the syndrome of the last recorded ECC event on on-chip memories. 
   For 32 bit memory, just low 7 bits([6:0]) is effective. 
   For 64 bit memory, the 8 bits ([7:0]) is effective.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ERINFO5_CNT</name>
          <description></description>
          <addressOffset>0x168</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>For each correctable error event, the EMU increments this field's error count value until the counter reaches its maximum value 0xFF. CNT will not change once it reaches 0xFF and will not wrap even if error occurs.
Read this field to determine the correctable error count value so far.
Write zero to this field to reset the counter. Writing non-zero (or partial zero) values has no effect.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>



      </registers>
    </peripheral>

    <peripheral>
      <name>FMU0</name>
      <description>Chip fault collect and process</description>
      <groupName>FMU</groupName>
      <prependToName>FMU0_</prependToName>
      <baseAddress>0x401C0000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>LOCK</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>KEY</name>
              <description>Configure to unlock or lock protection.Write 0xA765 to this register to unlock;write 0x46B0 to lock. When read this register, it returns the lock status. \newline Read value 0x0 means lock state. \newline Read value 0x1 means unlock state. \newline</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>OP</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>KEY</name>
              <description>Write Only. OP can only be configured if KEY is written 0xFA65 at the same time.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>OPS</name>
              <description>Read Only. OPS indicates the operation status.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>IDLE</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>In progress</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Aborted</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Successful</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OP</name>
              <description>Write only. Configure OP to change FMU status or clear status register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>OP0, no operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>OP1, put FMU in CFG state</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>OP2, put FMU in RUN state</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>OP3, clear FAULT_FSM_ST and ALARM_FSM_ST register</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>OP4, set OPS to IDLE</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>others</name>
                  <description>Undefined</description>
                  <value>others</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CTRL</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010005</resetValue>
           <fields>
            <field>
              <name>FUNC_CLKSEL_KEY</name>
              <description>Write only. FUNC_CLKSEL can be configured only if FUNC_CLKSEL_KEY is written 0x5A at the same time.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>FUNC_CLKSEL</name>
              <description>Select FMU module's functional clock source. This bit is reset by POR and should be configured when FMU module is static.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>SIRC_DIV4(SIRC clock divided by 4)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FIRC</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>SXOSC</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>FXOSC</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>PLL</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>others</name>
                  <description>Reserved, no clock source selected</description>
                  <value>others</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DBGDIS</name>
              <description>Configure to enable or disable fault input in debug mode. This bit is reset by POR.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Fault input is enabled in debug mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Fault input is disabled in debug mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CFG_TO_INT_EN</name>
              <description>Configure this bit to enable CFG state timeout interrupt. This bit is reset by POR.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>CFG state timeout interrupt is disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>CFG state timeout interrupt is enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CFG_CNT_TO_TH</name>
              <description>Configure the CFG state counter timeout threshold. The CFG state counter timeout if it reaches (CFG_CNT_TO_TH * 32). CFG_CNT_TO_TH is reset by POR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>15</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ST</name>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00001100</resetValue>
           <fields>
            <field>
              <name>FIN3_FAULT_ST</name>
              <description>FMU_ERR_IN3 fault status. Write 1 to clear. This bit is reset by POR.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No FMU_ERR_IN3 fault</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_IN3 fault has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FIN2_FAULT_ST</name>
              <description>FMU_ERR_IN2 fault status. Write 1 to clear. This bit is reset by POR.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No FMU_ERR_IN2 fault</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_IN2 fault has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FIN1_FAULT_ST</name>
              <description>FMU_ERR_IN1 fault status. Write 1 to clear. This bit is reset by POR.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No FMU_ERR_IN1 fault</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_IN1 fault has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FIN0_FAULT_ST</name>
              <description>FMU_ERR_IN0 fault status. Write 1 to clear. This bit is reset by POR.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No FMU_ERR_IN0 fault</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_IN0 fault has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FOUT1_ST</name>
              <description>Read Only. FOUT1_ST monitors fault output 1. For test.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FOUT0_ST</name>
              <description>Read Only. FOUT0_ST monitors fault output 0. For test.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FMU_FAULTY</name>
              <description>Read Only. FMU_FAULTY indicates whether FMU FSM is FAULT state.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU FSM is not in FAULT state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU FSM is in FAULT state.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FMU_FSM_ST</name>
              <description>Read Only. Read FMU_FSM_ST to check FMU FSM current state.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>IDLE</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>RUN</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>CFG</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>ALARM</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>FAULT</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>others</name>
                  <description>Undefined</description>
                  <value>others</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ALARM_TO</name>
              <description>Read Only. ALARM_TO indicates whether ALARM state timeout.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>ALARM state not timeout.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>ALARM state timeout.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CFG_TO_INT</name>
              <description>CFG state timeout interrupt flag. Write 1 to clear.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No CFG state timeout interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>CFG state timeout interrupt has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ALARM_INT</name>
              <description>Alarm interrupt flag. Write 1 to clear.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No alarm interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Alarm interrupt has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FAULT_INT</name>
              <description>Fault non maskable interrupt flag. Write 1 to clear.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No fault non maskable interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Fault non maskable interrupt has occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CFG_CNT</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>Read Only. Read CFG_CNT returns the value of the CFG state counter.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FAULT_ST0</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ST</name>
              <description>ST[n](n=0~31) is the FAULT status of channel numbered by "n". Write 1 to clear. This bit is reset by POR. \newline When ST[n] is 0b, the channel[n] has no fault \newline When ST[n] is 1b, The channel[n] fault has occurred</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FAULT_ST1</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ST</name>
              <description>ST[n](n=0~3) is the FAULT status of channel numbered by "n+32". Write 1 to clear. This bit is reset by POR. \newline When ST[n] is 0b, the channel[n+32] has no fault \newline When ST[n] is 1b, the channel[n+32] fault has occurred</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FAULT_ST_KEY</name>
          <description></description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>KEY</name>
              <description>Write Only. Write 0x52CB_6701 to unlock FAULT_ST write.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FAULT_FSM_ST</name>
          <description></description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>R2F_ST</name>
              <description>Record the number of FAULT channel which caused FMU FSM turning to FAULT from RUN. Reset by POR. For internal test.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>A2F_ST</name>
              <description>Record the number of FAULT channel which caused FMU FSM turning to FAULT from ALARM. Reset by POR. For internal test.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ALARM_CNT_TO_TH</name>
          <description></description>
          <addressOffset>0x3c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0003a980</resetValue>
           <fields>
            <field>
              <name>CNT_TO_TH</name>
              <description>When ALARM counter threshold expired, ALARM timeout occurs</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ALARM_CNT</name>
          <description></description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>Read Only. Read CNT returns the value of ALARM counter.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ALARM_FSM_ST</name>
          <description></description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>R2A_ST</name>
              <description>Record the number of FAULT channel which caused FMU FSM turning to ALARM from RUN. Reset by POR. For internal test.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>F2A_ST</name>
              <description>Record the number of FAULT channel which caused FMU FSM turning to ALARM from FAULT. Reset by POR. For internal test.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FOUT_CFG</name>
          <description></description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CTRL</name>
              <description>Configure FMU_ERR_OUT source. It's reset by POR.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU_ERR_OUT is controlled by FMU FSM</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_OUT is controlled by Soft(FOUT_FRC)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FAULT_INDICATION</name>
              <description>Configure FAULT_INDICATION to select whether FMU_ERR_OUT output as FAULT when in CFG state. It's reset by POR.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU_ERR_OUT output as RUN state when in CFG state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_OUT output as FAULT state when in CFG state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CFGST_HIMPD_EN</name>
              <description>Enable FMU_ERR_OUT high impedance output when FMU in CFG state. It's reset by POR.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable high impedance output when in CFG state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable high impedance output when in CFG state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FOUT1_POL</name>
              <description>Configure FMU_ERR_OUT1 polarity. It's reset by POR.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU_ERR_OUT1 is high when in fault state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_OUT1 is low when in fault state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FOUT0_POL</name>
              <description>Configure FMU_ERR_OUT0 polarity. It's reset by POR.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU_ERR_OUT0 is low when in fault state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FMU_ERR_OUT0 is high when in fault state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FOUT_MODE</name>
              <description>Select FMU fault output mode. It's reset by POR.</description>
