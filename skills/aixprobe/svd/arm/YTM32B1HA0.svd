          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>NCIE</name>
              <description>Non-Correctable error interrupt enable.
  0b - Channel n Non-Correctable Error interrupt is disabled
  1b - Channel n Non-Correctable Error interrupt is enabled</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCIE</name>
              <description>Single correctable error interrupt enable
  0b - Channel n Single Correctable Error interrupt is disabled
  1b - Channel n Single Correctable Error interrupt is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

