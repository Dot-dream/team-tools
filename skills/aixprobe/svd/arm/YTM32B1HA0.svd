        <register>
        <name>FXOSC_CTRL</name>
          <description>FXOSC control register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00001810</resetValue>
           <fields>
            <field>
              <name>HYSTDIS</name>
              <description>This bit should not be changed when FXOSC_VALID is high</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ALCDIS</name>
              <description>This bit should not be changed when FXOSC_VALID is high</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>COMPEN</name>
              <description>Comp enable bit, this bit should be high when crystal mode is used, and it should be low when bypass mode is used, and it should not be changed when FXOSC_VALID is high</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GMSEL</name>
              <description>Gain select bit, higher gain value results higher power and better performance, it only impact FXOSC crystal mode, and it should not be changed when FXOSC_VALID is high</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FXOSC_MODE</name>
              <description>Select FXOSC crystal mode or bypass mode, it should not be changed when FXOSC_VALID is high</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FXOSC bypass mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FXOSC crystal mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FXOSC_DS_EN</name>
              <description>Enable/Disable FXOSC when chip enters Deepsleep mode.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable FXOSC when chip enters Deepsleep mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable FXOSC when chip enters Deepsleep mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FXOSC_EN</name>
              <description>Enable/Disable Fast Crystal Oscillator(FXOSC) regardless it is selected as system clock source..</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable FXOSC if it is not selected as system clock source</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable FXOSC regardless it is selected as system clock or not</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

