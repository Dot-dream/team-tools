                  <name>1</name>
                  <description>Valid input was detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FMFO</name>
              <description>Indicate fast message is received on any channel when FIFO is full. This bit is valid only when FIFO is enabled. Write 1 to clear this bit.</description>
