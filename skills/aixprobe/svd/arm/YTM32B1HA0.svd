            <field>
              <name>F0F</name>
              <description>Fault event 0 occurs flag. Write 1 to clear the bit.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CH7F</name>
              <description>Channel 7 flag is used for capture mode and compare mode. In capture mode, this flag sets when capture event occurs. In compare mode, this flag sets when counter matches the values. Write 1 to clear the bit.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
