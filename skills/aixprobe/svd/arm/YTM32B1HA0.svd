          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>GLOB</name>
              <description>Generate global base signal. This bit is used to synchronize with other eTMRs which CTRL[GLOBEN]=1.</description>
