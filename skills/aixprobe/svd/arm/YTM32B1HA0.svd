        <register>
        <name>MMC_TX_INTERRUPT_MASK</name>
          <description>This register maintains the masks for interrupts generated from all Transmit statistics counters.
The MMC Transmit Interrupt Mask register maintains the masks for the interrupts generated when the transmit statistic counters reach half of their maximum value or the maximum values. This register is 32 bit wide.</description>
          <addressOffset>0x710</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
