            <field>
              <name>CNTINIT</name>
              <description>Before the eTMR enables, select initial value source for counter.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
