            <field>
              <name>CLKSRC</name>
              <description>Clock source for counter, bus clock or external clock.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Select bus clock.</description>
