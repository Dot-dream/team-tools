                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>QDTOF</name>
              <description>When STS[QDTOF]=1, STS[QDDIR]=0, means quadrature decoder counter increase to QDMOD[QDMOD], then overflow to QDINIT[QDINIT]. When STS[QDTOF]=1, STS[QDDIR]=1, means quadrature decoder counter decrease to QDINIT[QDINIT], then overflow to QDMOD[QDMOD]. Write 1 to clear the bit.</description>
