            <field>
              <name>AXRHSTS</name>
              <description>When high, this bit indicates that the read channel of the AXI master is active, and it is transferring the data.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>AXI Master Read Channel Status not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>AXI Master Read Channel Status detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AXWHSTS</name>
              <description>EQOS-AXI Configuration:
When high, this bit indicates that the write channel of the AXI master is active, and it is transferring data.
EQOS-AHB Configuration:
When high, this bit indicates that the AHB master FSMs are in the non-idle state.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
