                <enumeratedValue>
                  <name>1</name>
                  <description>AXI Burst Length 16</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BLEN8</name>
              <description>When this bit is set to 1, the EQOS-AXI master can select a burst length of 8 on the AXI interface.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
