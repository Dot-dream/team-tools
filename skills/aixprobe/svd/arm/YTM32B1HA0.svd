            <field>
              <name>WUF</name>
              <description>Indicate received valid data from PAD. This flag can be used to wake up chip from low power mode. Write 1 to clear this bit.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
