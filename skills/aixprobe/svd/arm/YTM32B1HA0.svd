                <enumeratedValue>
                  <name>1</name>
                  <description>RxFIFO data number is greater than the watermark.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AHBTO</name>
              <description>AHB access timeout indicator. If OSPI has no response to the AHB access after the time specified by AHBCFG[AHBWT], this flag will be set.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No AHB access timeout detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>AHB access timeout detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AHBBSE</name>
              <description>AHB burst size error indicator. If burst size greater than the data size, this flag will set.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
