          </fields>
        </register>

        <register>
        <name>TFR2</name>
          <description></description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>WCS</name>
              <description>Indicates FIFO of this channel is to be write next during FIFO combine mode.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
