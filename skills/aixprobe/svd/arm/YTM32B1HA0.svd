                <enumeratedValue>
                  <name>6</name>
                  <description>Address configured in BOOT_ADDR[31:15]</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>QSPI base</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BOOT_ADDR</name>
              <description>BOOT_ADDR configures the address chip boot from, valid when BOO_SEL is 0b110. BOOT_ADDR is from the boot address's Bit31~Bit15, lower 15 bits are masked, which means the address chip boot from is 32KB aligned.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>17</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
