          </fields>
        </register>

        <register>
        <name>OTRIG</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>TWD</name>
              <description>Trigger output width configurable from 1 to 256 bus clock cycles. Default trigger width is 1 bus clock cycle.</description>
