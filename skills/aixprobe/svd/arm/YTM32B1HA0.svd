                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Underflow detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXOF</name>
              <description>RxFIFO overflow indicator.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
