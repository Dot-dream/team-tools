            <field>
              <name>ENT</name>
              <description>The entropy value will be valid when STAT[ENT_VAL_IF] = 1. Reading the highest offset(ENT(7)) will clear the entire entropy value and start a new entropy generation.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
