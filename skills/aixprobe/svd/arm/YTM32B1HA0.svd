    <peripheral>
      <name>EMU</name>
      <description>ECC Management Unit</description>
      <groupName>EMU</groupName>
      <prependToName>EMU_</prependToName>
      <baseAddress>0x401C8000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>364</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>EIGCR</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>GEN</name>
              <description>This bit will enable or disable all error injection functions.
Write 0x89abcdef will enable this function.
Read 0 means, global error injection is disabled
Read 1 means, global error injection is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHCR</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHEN</name>
              <description>This field enable or disable channel n error injection function. 
Enable channel n error injection function should enable this field and EIGCR[GEN]. 
Any write to EICHDn_ADDR, EICHDn_CHKBIT, EICHDn_DATAH/L register will clear this field.
  0b - Channel n error injection is disabled
  1b - Channel n error injection is enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

                                <register>
        <name>EICHD0_ADDR</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field defines which address will be injected error when read access. when the ADDR is not 0, error will be injected according to this field's value. If ADDR is 0, Error will be injected at all read access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_CHKBIT</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHKBIT</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the checkbit bus from the target on-chip memory should be inverted or remain unmodified.\newline 0b - The corresponding bit of the checkbit bus remains unmodified.\newline 1b - The corresponding bit of the checkbit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_DATAL</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATAL</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data bus from the target on-chip memory should be inverted or remain unmodified. \newline 0b - The corresponding bit of the databit bus remains unmodified. \newline 1b - The corresponding bit of the databit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD0_DATAH</name>
          <description></description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>DATAH</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data bus from the target on-chip memory should be inverted or remain unmodified. \newline 0b - The corresponding bit of the databit bus remains unmodified. \newline 1b - The corresponding bit of the databit bus is inverted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


                                <register>
        <name>EICHD1_ADDR</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ADDR</name>
              <description>This field defines which address will be injected error when read access. when the ADDR is not 0, error will be injected according to this field's value. If ADDR is 0, Error will be injected at all read access.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>EICHD1_CHKBIT</name>
          <description></description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
