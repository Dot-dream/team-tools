                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Generate trigger when counter matches with MID[MID].</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INITTEN</name>
              <description>Enable/disable the INIT[INIT] matching trigger.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
