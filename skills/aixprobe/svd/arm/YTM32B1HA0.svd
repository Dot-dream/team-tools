            </field>
            <field>
              <name>DNIB0</name>
              <description>Data 0 nibble of received Fast Message.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DNIB1</name>
