              </enumeratedValues>
            </field>
            <field>
              <name>MIDTEN</name>
              <description>Enable/disable the MID[MID] matching trigger.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
