              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Bi-stable mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>others</name>
                  <description>Undefined</description>
                  <value>others</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FOUT1_EN</name>
              <description>Configure to enable output FMU_ERR_OUT1. It's reset by POR.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU_ERR_OUT1 output disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
