                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Counter initial value is from register INIT.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLDOK</name>
              <description>Write 1 to this bit to clear SYNC[LDOK], and it automatically clear when SYNC[LDOK]=0.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LDOK</name>
