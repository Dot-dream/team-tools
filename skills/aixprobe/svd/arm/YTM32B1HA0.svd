          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>PIF</name>
              <description>Indicate the detection for the defined event in PCTRL[IRQC] of the corresponding pin.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No event detected.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The event defined in PCTRL[IRQC] is detected.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>PCR0</name>
          <description></description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>INVE</name>
              <description>Invert the input logic level when configured for digital function.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IRQC</name>
              <description></description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>DMA request on rising edge.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>DMA request on falling edge.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>DMA request on either edge.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>Reserved.</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>Reserved.</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>Reserved.</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>Reserved.</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>Interrupt when logic 0.</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9</name>
                  <description>Interrupt on rising-edge.</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>Interrupt on falling-edge.</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11</name>
                  <description>Interrupt on either edge.</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>Interrupt when logic 1.</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>13</name>
                  <description>Reserved</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>14</name>
                  <description>Reserved</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
