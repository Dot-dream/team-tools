                  <description>Port input disable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>PIFR</name>
          <description></description>
          <addressOffset>0x1c</addressOffset>
