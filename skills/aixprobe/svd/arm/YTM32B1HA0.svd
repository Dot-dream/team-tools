        <register>
        <name>FOUT_MIN_WIN</name>
          <description></description>
          <addressOffset>0x4c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>MIN_WIN</name>
              <description>Configure the minimum time window of FMU_ERR_OUT output. It's reset by POR. The minimum time is (MIN_WIN * 1024) cycles of functional clock.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

