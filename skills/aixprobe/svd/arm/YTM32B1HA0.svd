                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>FOUT_CNT</name>
          <description></description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>Read FOUT_CNT returns the value of FMU_ERR_OUT window counter</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FFTR_CTRL</name>
          <description></description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>KEY</name>
              <description>CLKSEL can only be configured if KEY is written 0xA5 at the same time.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CLKSEL</name>
              <description>Select the clock source of FMU fail to react detect function. It's reset by POR and should be configured when FMU module is static.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>SIRC_DIV4(SIRC clock divided by 4)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>FIRC</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>SXOSC</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>FXOSC</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>PLL</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>others</name>
                  <description>Reserved, no clock source selected</description>
                  <value>others</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>FFTR_CNT_TO_TH</name>
          <description></description>
          <addressOffset>0x5c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT_TO_TH</name>
              <description>Configure FMU fail to react counter timeout threshold. The counter threshold is ((CNT_TO_TH + 1) * 4096) cycles of FFTR clock. It's reset by POR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FFTR_CNT</name>
          <description></description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CNT</name>
              <description>Read FFTR_CNT returns the value of FMU fail to react counter</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FAULT_INJ</name>
          <description></description>
          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
           <fields>
            <field>
              <name>WIN</name>
              <description>Configure fault injection time window</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CHNUM</name>
              <description>Configure the channel number to inject fault.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>KEY</name>
              <description>Fault injection assert when KEY is written 0x69.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FIN_CTRL</name>
          <description></description>
          <addressOffset>0x68</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>FIN_INT_EN</name>
              <description>Enable FMU_ERR_IN fault to generate interrupt. FIN_INT_EN[n] enables the correspond FMU_ERR_INn to generate interrupt. FIN_INT_EN is reset by POR. \newline When FIN_INT_EN[n] is 0b, FMU_ERR_INn fault not generate interrupt. \newline When FIN_INT_EN[n] is 1b, FMU_ERR_INn fault generate interrupt.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FIN_RST_EN</name>
              <description>Enable FMU_ERR_IN fault to generate reset. FIN_RST_EN[n] enables the correspond FMU_ERR_INn to generate reset. FIN_RST_EN is reset by POR. \newline When FIN_RST_EN[n] is 0b, FMU_ERR_INn fault not generate reset. \newline When FIN_RST_EN[n] is 1b, FMU_ERR_INn fault generate reset.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FIN_POL</name>
              <description>Select FMU_ERR_IN Polarity. FIN_POL[n] select the polarity of the correspond FMU_ERR_INn. It's reset by POR. \newline When FIN_POL[n] is 0b, FMU_ERR_INn input high will generate fault. \newline When FIN_POL[n] is 1b, FMU_ERR_INn input low will generate fault.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FIN_EN</name>
              <description>Enable FMU_ERR_IN input. Set FIN_EN[n] to 1, the correspond FMU_ERR_INn input is enabled. It's reset by POR. \newline When FIN_EN[n] is 0b, FMU_ERR_INn is disable. \newline When FIN_EN[n] is 1b, FMU_ERR_INn is enable.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>FCH_CTRL0</name>
