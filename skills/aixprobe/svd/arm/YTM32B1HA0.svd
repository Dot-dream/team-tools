           <fields>
            <field>
              <name>FOUT1</name>
              <description>Control FMU_ERR_OUT1 output</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>FMU_ERR_OUT1 output low</description>
                  <value>0</value>
