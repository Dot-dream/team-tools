                <enumeratedValue>
                  <name>1</name>
                  <description>SDR mode sample edge is falling edge, or the first sample edge is falling edge in DQS mode.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DDRHLF</name>
