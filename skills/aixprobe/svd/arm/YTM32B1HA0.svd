                  <name>1</name>
                  <description>AXI Burst Length 32</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BLEN16</name>
              <description>When this bit is set to 1, the EQOS-AXI master can select a burst length of 16 on the AXI interface.</description>
