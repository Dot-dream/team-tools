          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CHAIN</name>
              <description>When setting this bit, it will link multi-channel in sequence to combine a new bits counter, it just links the front channel.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Chaining is disabled, channel timer runs independently</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
