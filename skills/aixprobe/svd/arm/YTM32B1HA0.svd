            <field>
              <name>CALRESYNCIE</name>
              <description>Resynchronized error interrupt enable control.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disabled.</description>
                  <value>0</value>
