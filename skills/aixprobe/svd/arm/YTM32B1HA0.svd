                  <name>1</name>
                  <description>I2C slave received STOP</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADDRIF</name>
              <description>Address valid set when address match received and cleared after read address register or read DATA register when RXCFG bit set</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
