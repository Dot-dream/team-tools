                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>32-bit</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>64-bit</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>16 bytes burst</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>32 bytes burst</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CTS21_BCNT</name>
          <description>Transfer loop byte count is the number of bytes to be transferred in each trigger loop.</description>
          <addressOffset>0x6a8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>BCNT</name>
              <description>Valid for CTRL[LOEN] = 0, Transfer loop byte count is the number of bytes to be transferred in each trigger loop.</description>
