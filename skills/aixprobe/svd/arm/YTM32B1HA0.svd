              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>LINFlexD receives the data and copy it to the DATA registers.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>LINFlexD transmits the data from the DATA register.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CCS</name>
              <description>Controls the type of checksum applied on the current message.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Enhanced checksum covering identifier and data fields. This is compatible with LIN specification rev. 2.0 and higher.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Classic checksum covering data field only. This is compatible with LIN specification rev. 1.3 and lower.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
