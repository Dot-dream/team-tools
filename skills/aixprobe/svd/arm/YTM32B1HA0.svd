                <enumeratedValue>
                  <name>5</name>
                  <description>Running (Closing the Rx Descriptor)</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>Timestamp write state</description>
