                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enhanced Serial Message with 4-bit ID field.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
