    <peripheral>
      <name>SCU</name>
      <description>System Clock Unit of Microcontroller</description>
      <groupName>SCU</groupName>
      <prependToName>SCU_</prependToName>
      <baseAddress>0x401F0000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>108</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CLKS</name>
          <description>The register contains system clock source selection bit, the system clock source is the root of system clock divider which generates Core/Platform Clock, Fast Bus Clock and Slow Bus Clock.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CLKSRCSEL</name>
              <description>Select System Clock Source.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Select FIRC as system clock source</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Select PLL as system clock source</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>Select FXOSC as system clock source</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Select SIRC as system clock source</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

