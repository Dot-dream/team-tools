                <enumeratedValue>
                  <name>2</name>
                  <description>Compare mode.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>Capture mode.</description>
                  <value>3</value>
