<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd">
  <vendor>YTMicro</vendor>
  <vendorID>YTMicro</vendorID>
  <name>YTM32B1HA0</name>
  <series></series>
  <version>1.0</version>
  <description>YTM32B1HA0 YTMicro Microcontroller</description>
  <licenseText>YTMicro Microcontroller all rights reserved.</licenseText>
  <cpu>
    <name></name>
    <revision></revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>true</fpuPresent>
    <nvicPrioBits>2</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>EFM</name>
      <description>Embedded FLASH Module</description>
      <groupName>EFM</groupName>
      <prependToName>EFM_</prependToName>
      <baseAddress>0x40040000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>1024</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
        <name>CTRL</name>
          <description></description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x800c0100</resetValue>
           <fields>
            <field>
              <name>DPD_EN</name>
              <description>This DPD_EN bit determines whether the Flash will enter deep power-down mode when MCU is entering deep sleep mode.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash will keep active when MCU enters deep sleep mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash will enter deep power-down mode when MCU enters deep sleep mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RETRY_CFG</name>
              <description>These RETRY_CFG bits set Erase-Retry order in manual-erase operation.\newline For pre-erase control, RETRY_CFG[2:0] \newline =001 for 1st pre-erase pulse \newline =010 for 2nd pre-erase pulse \newline For Erase-Retry control, RETRY_CFG[2:0] \newline =100 for 1st erase pulse \newline =101 for 2nd erase pulse \newline =110 for 3rd erase pulse \newline =111 for4th to 20th erase pulse \newline</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ECCERR_INJ_EN</name>
              <description>This ECCERR_INJ_EN bit determines whether inject ECC error when Flash read.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable ECC error inject when read Flash.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable ECC error inject when read Flash.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECCERR_INJ_ALL</name>
              <description>This ECCERR_INJ_ALL bit determines ECC error inject happens for whether single or all Flash addresses.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>ECC error inject only when read address set in ECCERR_INJECT_ADDR[31:0].</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>ECC error inject when read any Flash address.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRESCALER</name>
              <description>These PRESCALER bits are used for EFM operation time control. \newline These bits need to be configured to half of APB clock frequency. \newline Please use the following equation to calculate the PRESCALER value: \newline PRESCALER = APB clock frequency / 2 (round up if not divisible). \newline Please re-configure PRESCALER once the frequency is changed.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PREFETCH_EN</name>
              <description>This PREFETCH_EN bit is used to enable prefetch read function. EFM read Flash address+1 when the bus interface is free. Then if bus read address+1 happens, prefetch hit, Flash data is send without waiting Flash access time. Only Flash main array support prefetch read function, read of NVR array will ignore this register.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable prefetch read function.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable prefetch read function.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WE</name>
              <description>This WE bit determines whether Flash is writable. Write Flash when WE=0 cause HRESP error and EFM_STATUS[CI_WEERR] flag is set at the same time.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable Flash write.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable Flash write.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RWS</name>
              <description></description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CMD_VERIFY_EN</name>
              <description>This CMD_VERIFY_EN bit determine whether do verify read after erase or program operation during executing a command. In verify read stage, read back and check Flash data of target sector. If Flash data checked failed, EFM_STATUS[FAIL] flag is set.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable verify read after erase or program operation.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable verify read after erase or program operation</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACCERRIE</name>
              <description>This ACCERRIE bit determines whether the interrupt will be generated if ACCERR flag is asserted.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if ACCERR flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if ACCERR flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNRECOVERRIE</name>
              <description>This UNRECOVERRIE bit determines whether the interrupt will be generated if UNRECOVERR flag is asserted.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if UNRECOVERR flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if UNRECOVERR flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RECOVERRIE</name>
              <description>This RECOVERRIE bit determines whether the interrupt will be generated if RECOVERR flag is asserted.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if RECOVERR flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if RECOVERR flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONEIE</name>
              <description>This DONEIE bit determines whether the interrupt will be generated if DONE flag is asserted.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable generating interrupt if DONE flag is asserted</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable generating interrupt if DONE flag is asserted</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>STS</name>
          <description></description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000080</resetValue>
           <fields>
            <field>
              <name>CI_RECOVERR</name>
              <description>1-bit ECC error is detected during core read access cause HRESP error and set CI_RECOVERR flag.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Recovery ecc error is not detected  during core read access.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>1-bit ECC error is detected  during core read access.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CI_UNRECOVERR</name>
              <description>More than 2-bits ECC error is detected during core read access cause HRESP error and set CI_UNRECOVERR  flag.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No unrecovery ECC error during core read access.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>2-bits ECC error or multi-bits ECC error is detected  during core read access.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CI_RDVIOLERR</name>
              <description>This CI_RDVIOLERR bit indicates whether a read violation error is detected.  \newline Read violation error includes below scenarios: \newline 1.Core read CUS_NVR sector when CUS_KEY is not set. \newline 2.Core read HCU_NVR sector when CFG_KEY is not set. \newline 3.Core read BOOT_NVR sector when FAC_KEY is not set. \newline 4.Core read FAC_NVR sector when FAC_KEY is not set. \newline 5.Core read NVR_CFG sectors when CFG_KEY is not set. \newline</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CI_WEERR</name>
              <description>The core tries to write Flash when EFM_CTRL[WE] is disabled cause HRESP error and set CI_WEERR flag.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CI_BUSYERR</name>
              <description>The core tries to access Flash when EFM_CTRL[IDLE] is 0 cause HRESP error and set CI_BUSYERR flag.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BOOT_INFO</name>
              <description>This BOOT_INFO bit indicates Flash loads codes from Block 0 or Block 1.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Flash is loading codes from Block 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Flash is loading codes from Block 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IDLE</name>
              <description>This IDLE bit indicates whether Flash is busy. IDLE is 0 in bellow scenarios: \newline 1. EFM is executing a command. \newline 2. The core is reading NVR array(dummy read command).</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SET_ADDR</name>
              <description>A write access to target address is needed before sending a command. The write access operation will set SET_ADDR flag. \newline \note{Sending a command when SET_ADDR is 1 avoids ACCERR caused by code's non-sequential schedule on AXI and AHBP interface.}</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FAIL</name>
              <description>This FAIL bit indicates whether the current command is failed. \newline Command fail includes below scenarios: \newline 1.program verify check is failed. \newline 2.erase verify check is failed.  \newline 3.Manual Erase-Retry Verify_Read check failed</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACCERR</name>
              <description>This ACCERR bit indicates whether there is an access error is detected.  \newline Access error scenarios refer to chapter "Flash Illegal Operation".</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Access error is not detected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Access error is detected</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNRECOVERR</name>
              <description>This UNRECOVERR bit indicates whether more than 2-bit ECC error is detected during command verify read stage.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No un-recovery ECC error  is detected in command verify read stage.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>2-bit or multi-bit ECC error find in command verify read stage.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RECOVERR</name>
              <description>This RECOVERR bit indicates whether there is a recovery ecc error is detected during command verify read stage.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No recovery ECC error  is detected in command verify read stage.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>1-bit ECC error is detected in command verify read stage.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DONE</name>
              <description>This DONE bit indicates whether the current command is completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Current command is in progress.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Current command is completed.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD</name>
          <description></description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD</name>
              <description>These CMD bits determine which commands are available.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1</name>
                  <description>PROG64 \newline Program 64bits. Verify if CMD_VERIFY_EN is set 1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>PROG256 \newline Program 256bits. Verify if CMD_VERIFY_EN is set 1.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16</name>
                  <description>ERASE_SECTOR \newline Erase Sector. Verify if CMD_VERIFY_EN is set 1.</description>
                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>17</name>
                  <description>ERASE_BLOCK \newline Erase Block (only main array). Verify if CMD_VERIFY_EN is set 1.</description>
                  <value>17</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>18</name>
                  <description>ERASE_CHIP \newline Erase Chip (all main arrays and PFlash0's NVR array). Ignore CMD_VERIFY_EN.</description>
                  <value>18</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>19</name>
                  <description>ERASE_RETRY_AUTO \newline Auto Erase-Retry (only main array sector).</description>
                  <value>19</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>20</name>
                  <description>ERASE_RETRY_MAN \newline Manual Erase-Retry (only main array sector).</description>
                  <value>20</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>21</name>
                  <description>ERASE_RETRY_VREAD \newline Manual Erase-Retry Verify-Read. Executed after a ERASE_RETRY_MAN command.</description>
                  <value>21</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32</name>
                  <description>LOAD_AES_KEY \newline Load AES Key command. Load 256-bits key data from Flash HCU_NVR array to HCU module.</description>
                  <value>32</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>48</name>
                  <description>BOOT_SWAP  \newline Boot Swap command to re-map block address.</description>
                  <value>48</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD_PROT</name>
          <description></description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD_PROT</name>
              <description>These CMD_PROT bits determine which commands are disabled. \newline Software can write 1 to value 0 bit, but can not clear value 1 bit to 0. \newline CMD_PROT[0]=1 disable PROG64 command; \newline CMD_PROT[1]=1 disable PROG256 command; \newline CMD_PROT[2]=1 disable ERASE_SECTOR command; \newline CMD_PROT[3]=1 disable Erase Block command; \newline CMD_PROT[4]=1 disable ERASE_CHIP command; \newline CMD_PROT[5]=1 disable ERASE_RETRY_AUTO command; \newline CMD_PROT[6]=1 disable ERASE_RETRY_MAN command; \newline CMD_PROT[7]=1 disable ERASE_RETRY_VREAD command; \newline CMD_PROT[8]=1 disable LOAD_AES_KEY command; \newline CMD_PROT[9]=1 disable BOOT_SWAP command;</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>TIMING1</name>
          <description></description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00050010</resetValue>
           <fields>
            <field>
              <name>TPREPROG</name>
              <description>These TPREPROG bits indicate the pre-program time, and the time unit is 0.5us. \newline Please use the following equation to calculate TPREPROG value: \newline TPREPROG = (2.5 to 3.5) * 2</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TPROG</name>
              <description>These TPROG bits indicate the program time, and the time unit is 0.5us. \newline Please use the following equation to calculate TPROG value: \newline TPROG = (8 to 10) * 2</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>TIMING2</name>
          <description></description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x06408000</resetValue>
           <fields>
            <field>
              <name>TERASE_RETRY</name>
              <description>These TERASE_RETRY bits indicate the Erase-Retry time, and the time unit is 0.5us. \newline Please use the following equation to calculate TERASE_RETRY value: \newline TERASE = (0.8 to 1) * 1000 * 2 \newline \note{Both Manual and Auto Erase-Retry are sector erase for main array.}</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TERASE</name>
              <description>These TERASE bits indicate the single erase time, and the time unit is 0.5us. \newline Please use the following equation to calculate TERASE value: \newline TERASE = (16 to 20) * 1000 * 2 \newline \note{Both ERASE_SECTOR and ERASE_CHIP command use this single erase time.}</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ECCERR_INJECT_MSK_0</name>
          <description></description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ECCERR_INJECT_MSK</name>
              <description>ECCERR_INJECT_MSK[63:0] is used to inject ECC error into Flash read data bus (64 bits). \newline This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data[31:0] from the target Flash should be inverted or remain unmodified. \newline For example, 32'h00000100 means Flash read data bit[12] is inverted. \newline This register is valid only when ECCERR_INJ_EN is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ECCERR_INJECT_MSK_1</name>
          <description></description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ECCERR_INJECT_MSK</name>
              <description>This field defines a bit-mapped mask that specifies whether the corresponding bit of the read data[63:32] from the target Flash should be inverted or remain unmodified. \newline For example, 32'h00000002 means Flash read data bit[33] is inverted. \newline This register is valid only when ECCERR_INJ_EN is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ECCERR_INJECT_ADDR</name>
          <description></description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>ECCERR_INJECT_ADDR</name>
              <description>This field defines Flash address which to inject ECC error. This register is valid only when ECCERR_INJ_ALL is 0 and ECCERR_INJ_EN is 1.  \newline</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT0</name>
          <description></description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>BLOCK_ADDR_PROT</name>
              <description>Each bit protects 32 KByte PFlash address area. \newline If any bit is set to 0, the corresponding 32 KByte area is under protection (this Flash area is read only). \newline During initialization, EFM load the 2nd data of CUS_NVR to ADDR_PROT if it is programmed with right tag.\newline Software can write 0 to value 1 bit, but can not write 1 to value 0 bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT1</name>
          <description></description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>BLOCK_ADDR_PROT</name>
              <description>Each bit protects 32 KByte PFlash address area. \newline If any bit is set to 0, the corresponding 32 KByte area is under protection (this Flash area is read only). \newline During initialization, EFM load the 2nd data of CUS_NVR to ADDR_PROT if it is programmed with right tag.\newline Software can write 0 to value 1 bit, but can not write 1 to value 0 bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ADDR_PROT2</name>
          <description></description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>BLOCK_ADDR_PROT</name>
              <description>Each bit protects 32 KByte PFlash address area. \newline If any bit is set to 0, the corresponding 32 KByte area is under protection (this Flash area is read only). \newline During initialization, EFM load the 2nd data of CUS_NVR to ADDR_PROT if it is programmed with right tag.\newline Software can write 0 to value 1 bit, but can not write 1 to value 0 bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>ECC_ERR_ADDR</name>
          <description></description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
           <fields>
            <field>
              <name>ECC_ERR_ADDR</name>
              <description>These bits recorded the first detected ECC error address. Followed ECC error address are not recorded.\newline When detect a ECC error, hardware set ECC error flag (CI_RECOVERR or CI_UNRECOVERR or RECOVERR or UNRECOVERRR). If ECC_ERR_ADDR is currently default, write error address to ECC_ERR_ADDR at the same time. \newline ECC_ERR_ADDR is cleared by write 1 to the corresponding error flag. If ECC_ERR_ADDR records CI_UNRECOVERR address, write 1 to CI_RECOVERR or RECOVERR or UNRECOVERRR could not clear ECC_ERR_ADDR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CMD_UNLOCK</name>
          <description></description>
          <addressOffset>0x200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CMD_UNLOCK_KEY</name>
              <description>Please write 0xfd9573f5 before launching any command</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CUS_KEY</name>
          <description></description>
          <addressOffset>0x204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
           <fields>
            <field>
              <name>CUS_KEY_MATCH</name>
              <description>This CUS_KEY_MATCH bit indicates whether Customer Key is matched.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Customer Key is not matched</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Customer Key is matched</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CUS_NVR_KEY</name>
              <description>Please write Customer Key before any protected NVR operation. Default  Customer Key is 0x4dff32, re-defined by program CUS NVR first address and reset EFM.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>

        <register>
        <name>CTRL_OVRD</name>
          <description></description>
          <addressOffset>0x300</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
           <fields>
            <field>
              <name>CHK_ADDRERR_DIS</name>
              <description>Check address error includes below scenarios: \newline 1. Not equal HADDR[31:5] of multiple bus write before sending a program 256bit command cause ACCERR. \newline 2. Not equal HADDR[31:3] of multiple bus write before sending a program 64bit command  cause ACCERR.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Check address error before program operation.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Don't check address error before program operation.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>POST_FETCH_EN</name>
              <description>This bit determines whether bus read assist post-fetch function.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Disable post-fetch function.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Enable post-fetch function.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRE_ERASE_EN</name>
              <description>This bit determines whether do pre-erase in Auto Erase-Retry command.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PROG_CHK_DIS</name>
              <description>Before program operation, read Flash and check if program target addresses are erased. This function called program check. \newline PRE_ERASE_EN[0] determine if PFlash0 program check is override disabled;  \newline PRE_ERASE_EN[1] determine if PFlash1 program check is override disabled;  \newline PRE_ERASE_EN[2] determine if DFlash program check is override disabled.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PREPROG_DIS</name>
              <description>This bit determines whether do pre-program in program command.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SWD_DISABLE</name>
              <description>This bit determines whether the Software Debugger is override disabled.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>Software Debugger is not override disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>Software Debugger is override disabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECC_DISABLE</name>
              <description>ECC_DISABLE[0] determine if PFlash0 ECC is  is override disabled;  \newline ECC_DISABLE[1] determine if PFlash1 ECC is  is override disabled;  \newline ECC_DISABLE[2] determine if DFlash ECC is  is override disabled.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>


      </registers>
    </peripheral>

