                  <description>Don't care.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>DATA TEST is failed, no valid data is sampled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
