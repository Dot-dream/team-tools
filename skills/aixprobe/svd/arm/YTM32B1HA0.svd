              </enumeratedValues>
            </field>
            <field>
              <name>DBSW23</name>
              <description>Channel 2 and 3 is used to generate the double switch signal.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
