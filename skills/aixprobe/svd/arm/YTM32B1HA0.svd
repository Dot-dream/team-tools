            </field>
            <field>
              <name>RXWE</name>
              <description>RxFIFO data number exceed watermark indicator.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
