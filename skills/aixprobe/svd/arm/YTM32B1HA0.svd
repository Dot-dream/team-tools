                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>select channel 7 PWM as the pulse-out signal.</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TSRC</name>
